        window.setTimeout(() => { if (bubbles.get(one) !== bubble) return; bubbles.delete(one); bubble.classList.add("leaves"); window.setTimeout(() => bubble.remove(), 220); }, time || 1500 + words.length * 38);
      };
      // whoever is spoken to turns to the speaker and shows what it makes of the words
      const reacts: Record<TalkMood, SpritePose> = { chat: { eyes: "r" }, hi: { eyes: "happy", arms: "wave" }, ask: { eyes: "u" }, yay: { eyes: "happy", mouth: "smile" }, laugh: { eyes: "happy", mouth: "open" }, hmm: { eyes: "sleepy" }, oh: { eyes: "wide", mouth: "o" } };
