# Sevinda shell integration for bash, started as `bash --rcfile <this file> -i`.
# Generated by Sevinda and rewritten when it changes; edit your own startup files instead.
#
# bash ignores --rcfile in a login shell, so Sevinda starts an interactive shell with this file and reads what a
# login shell would: /etc/profile, then the first of ~/.bash_profile, ~/.bash_login and ~/.profile (falling back to
# ~/.bashrc when none exists). Sevinda's functions come last, so a claude or codex function of your own wins.

if [ -r /etc/profile ]; then
  . /etc/profile
fi
if [ -r "$HOME/.bash_profile" ]; then
  . "$HOME/.bash_profile"
elif [ -r "$HOME/.bash_login" ]; then
  . "$HOME/.bash_login"
elif [ -r "$HOME/.profile" ]; then
  . "$HOME/.profile"
elif [ -r "$HOME/.bashrc" ]; then
  . "$HOME/.bashrc"
fi

__sevinda_integration_dir="${BASH_SOURCE[0]%/*}"
if [ -r "$__sevinda_integration_dir/claude-shell-function.bash" ]; then
  . "$__sevinda_integration_dir/claude-shell-function.bash"
fi
if [ -r "$__sevinda_integration_dir/codex-shell-function.bash" ]; then
  . "$__sevinda_integration_dir/codex-shell-function.bash"
fi
unset __sevinda_integration_dir

# Reports the working directory at every prompt (OSC 7), so paths a command prints relative to it resolve against the
# directory the shell is in, not the one the session started in.
__sevinda_report_cwd() {
  builtin printf '\e]7;file://%s%s\a' "${HOSTNAME}" "${PWD//\%/%25}"
}
case ";${PROMPT_COMMAND-};" in
  *";__sevinda_report_cwd;"*) ;;
  *) PROMPT_COMMAND="__sevinda_report_cwd${PROMPT_COMMAND:+;$PROMPT_COMMAND}" ;;
esac
