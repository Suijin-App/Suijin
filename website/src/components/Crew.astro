          scaleY: [{ to: 0.84, duration: 90, ease: "outQuad" }, { to: 1.1, duration: 210, ease: "outQuad" }, { to: 1, duration: 150 }, { to: 0.87, duration: 80 }, { to: 1, duration: 260, ease: "outElastic(1, .5)" }],
          scaleX: [{ to: 1.1, duration: 90, ease: "outQuad" }, { to: 0.95, duration: 210, ease: "outQuad" }, { to: 1, duration: 150 }, { to: 1.09, duration: 80 }, { to: 1, duration: 260, ease: "outElastic(1, .5)" }],
