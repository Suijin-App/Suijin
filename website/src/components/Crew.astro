        const witness = members.find((other) => other !== one && idle(other) && !other.busy && inSight(other));
        if (witness) window.setTimeout(() => { if (held === one) speak(witness, any1(plays.held.watch), "ask"); }, 1500);
      };
      const drop = () => {
        const one = held!;
        held = null; window.clearInterval(kicking); one.post.classList.remove("held");
        if (one.state !== "swim" || one.goal) return;           // sent off meanwhile (the reader shooed them): it is on its way already
        const here = feet(one), off = (spot: { x: number; y: number }) => Math.hypot(spot.x - here.x, spot.y - here.y);
        const post = one.home?.() ?? null;
        if (post && onScreen(post.y) && off(post) < 80) { land(one, post, true, null); return; }
        const edge = perches().filter((place) => members.every((other) => other === one || off(place) > 0 && Math.hypot(feet(other).x - place.x, feet(other).y - place.y) > wide() * 1.3)).sort((p, q) => off(p) - off(q))[0];
        if (edge && off(edge) < 90) { land(one, { x: edge.x, y: edge.y, rest: 0 }, false, edge.perch); return; }
        one.pose = { eyes: "wide", mouth: "o", arms: "up", legs: "tuck" }; draw(one);
        const fall = { p: 0 };
        animate(fall, { p: 1, duration: 260, ease: "inQuad",
          onUpdate: () => { if (one.state === "swim" && !one.goal) stand(one, here.x, here.y + 30 * fall.p); },
          onComplete: () => {
            if (one.state !== "swim" || one.goal) return;
            one.state = "away"; one.floating = true; one.post.classList.add("swims"); one.pose = { legs: "none", arms: "swimA", eyes: "shut", mouth: "o" }; draw(one);
            splash(here.x, here.y + 30 - line(), 1.1, one); speak(one, any1(plays.held.wet), "oh");
            window.setTimeout(roam, 900);                       // off to its post or the nearest free edge
          } });
      };
      document.addEventListener("pointermove", (event) => {
        if (held) carry(held, event);
        else if (grip && Math.hypot(event.clientX - grip.x, event.clientY - grip.y) > 6) { lift(grip.one, event); grip = null; }
      }, { passive: true });
      document.addEventListener("pointerup", (event) => { if (held) drop(); else if (grip) { press(grip.one); through(event.clientX, event.clientY); } grip = null; }, { passive: true });
      document.addEventListener("pointercancel", () => { if (held) drop(); grip = null; }, { passive: true });
      document.addEventListener("pointerdown", (event) => {
        stir();
        const target = (event.target as Element | null)?.closest?.("[data-sprite]");
        const pressed = members.find((one) => one.element === target);
        if (pressed) { grip = { one: pressed, x: event.clientX, y: event.clientY }; return; }   // a press or a pick-up: the release or the first move tells
        const near = members.filter(idle).map((one) => { const box = one.element.getBoundingClientRect(); return { one, far: Math.hypot(event.clientX - box.left - box.width / 2, event.clientY - box.top - box.height / 2) }; }).sort((a, b) => a.far - b.far)[0];
        if (near && near.far < 700) { feel(near.one, { eyes: "wide", mouth: "o" }, 520); hop(near.one, 14); }
      }, { passive: true });
      // the film opens or the theme changes: everyone reacts
      new MutationObserver((records) => {
        for (const record of records) {
          if (record.attributeName === "data-theater" && !document.documentElement.hasAttribute("data-theater")) { const critic = members.find(inSight); if (critic) window.setTimeout(() => speak(critic, any1(reactions.film), "yay"), 500); }
          if (record.attributeName === "data-theater" && document.documentElement.hasAttribute("data-theater")) members.forEach((one, index) => { feel(one, { eyes: "star", mouth: "smile", arms: "up", blush: true }, 1600); hop(one, 22, index * 80); });
          if (record.attributeName === "data-theme") { dye(); const witness = members.find(inSight); if (witness) window.setTimeout(() => speak(witness, any1(document.documentElement.dataset.theme === "dark" ? reactions.dark : reactions.light), "oh"), 300); }
          if (record.attributeName === "data-theme") members.forEach((one, index) => { feel(one, { eyes: "wide", mouth: "o" }, 800); hop(one, 12, index * 70); });
        }
      }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theater", "data-theme"] });
    }
  }
