# Mercury shell integration: the first file zsh reads from Mercury's ZDOTDIR.
# Generated by Mercury and rewritten when it changes; edit your own ~/.zshenv instead.
#
# Mercury points ZDOTDIR here so that it can add its functions after your own startup files. Every wrapper sources
# your file of the same name from your real ZDOTDIR (MERCURY_USER_ZDOTDIR, else $HOME), with ZDOTDIR set to that
# directory while it runs, then points ZDOTDIR back here so zsh finds the next wrapper. The last file zsh reads puts
# your ZDOTDIR back for good, so programs and nested shells see your environment unchanged.
# Wrappers source at the top level on purpose: inside a function, `typeset` in your files would declare locals.

typeset -g __mercury_zdotdir="${ZDOTDIR}"
if [[ -n "${MERCURY_USER_ZDOTDIR+x}" ]]; then
  export ZDOTDIR="${MERCURY_USER_ZDOTDIR}"
else
  unset ZDOTDIR
fi
unset MERCURY_USER_ZDOTDIR

if [[ -r "${ZDOTDIR:-$HOME}/.zshenv" ]]; then
  source "${ZDOTDIR:-$HOME}/.zshenv"
fi

# Your .zshenv may move ZDOTDIR (export ZDOTDIR=~/.config/zsh); the files that follow come from wherever it points now.
if [[ -n "${ZDOTDIR+x}" && "${ZDOTDIR}" != "${__mercury_zdotdir}" ]]; then
  typeset -g __mercury_user_zdotdir="${ZDOTDIR}" __mercury_user_zdotdir_set=1
else
  typeset -g __mercury_user_zdotdir="${HOME}" __mercury_user_zdotdir_set=0
fi

function __mercury_use_user_zdotdir {
  if [[ "${__mercury_user_zdotdir_set}" == 1 ]]; then
    export ZDOTDIR="${__mercury_user_zdotdir}"
  else
    unset ZDOTDIR
  fi
}

# Puts your ZDOTDIR back and removes every trace of the wrappers.
function __mercury_restore_zdotdir {
  __mercury_use_user_zdotdir
  unset __mercury_zdotdir __mercury_user_zdotdir __mercury_user_zdotdir_set
  unfunction __mercury_use_user_zdotdir __mercury_restore_zdotdir 2>/dev/null
}

if [[ -o interactive || -o login ]]; then
  export ZDOTDIR="${__mercury_zdotdir}"
else
  # No other startup file follows for a non-interactive, non-login shell.
  __mercury_restore_zdotdir
fi
