# Suijin shell integration: the first file zsh reads from Suijin's ZDOTDIR.
# Generated by Suijin and rewritten when it changes; edit your own ~/.zshenv instead.
#
# Suijin points ZDOTDIR here so that it can add its functions after your own startup files. Every wrapper sources
# your file of the same name from your real ZDOTDIR (SUIJIN_USER_ZDOTDIR, else $HOME), with ZDOTDIR set to that
# directory while it runs, then points ZDOTDIR back here so zsh finds the next wrapper. The last file zsh reads puts
# your ZDOTDIR back for good, so programs and nested shells see your environment unchanged.
# Wrappers source at the top level on purpose: inside a function, `typeset` in your files would declare locals.

typeset -g __suijin_zdotdir="${ZDOTDIR}"
if [[ -n "${SUIJIN_USER_ZDOTDIR+x}" ]]; then
  export ZDOTDIR="${SUIJIN_USER_ZDOTDIR}"
else
  unset ZDOTDIR
fi
unset SUIJIN_USER_ZDOTDIR

if [[ -r "${ZDOTDIR:-$HOME}/.zshenv" ]]; then
  source "${ZDOTDIR:-$HOME}/.zshenv"
fi

# Your .zshenv may move ZDOTDIR (export ZDOTDIR=~/.config/zsh); the files that follow come from wherever it points now.
if [[ -n "${ZDOTDIR+x}" && "${ZDOTDIR}" != "${__suijin_zdotdir}" ]]; then
  typeset -g __suijin_user_zdotdir="${ZDOTDIR}" __suijin_user_zdotdir_set=1
else
  typeset -g __suijin_user_zdotdir="${HOME}" __suijin_user_zdotdir_set=0
fi

function __suijin_use_user_zdotdir {
  if [[ "${__suijin_user_zdotdir_set}" == 1 ]]; then
    export ZDOTDIR="${__suijin_user_zdotdir}"
  else
    unset ZDOTDIR
  fi
}

# Puts your ZDOTDIR back and removes every trace of the wrappers.
function __suijin_restore_zdotdir {
  __suijin_use_user_zdotdir
  unset __suijin_zdotdir __suijin_user_zdotdir __suijin_user_zdotdir_set
  unfunction __suijin_use_user_zdotdir __suijin_restore_zdotdir 2>/dev/null
}

if [[ -o interactive || -o login ]]; then
  export ZDOTDIR="${__suijin_zdotdir}"
else
  # No other startup file follows for a non-interactive, non-login shell.
  __suijin_restore_zdotdir
fi
