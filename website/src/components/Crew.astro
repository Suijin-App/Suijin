      const snore = () => members.filter(idle).forEach((one, index) => window.setTimeout(() => { if (asleep && idle(one)) leave(one, "zzz"); }, index * 520));
      const sleep = () => { asleep = true; crew.classList.add("asleep"); members.filter(idle).forEach((one) => { one.pose.eyes = "shut"; one.mood = null; draw(one); });
        const sleepy = members.filter(idle).find(inSight); if (sleepy) speak(sleepy, any1(reactions.nap), "hmm");
