---
// The inspector column: the worktree's file tree, or its details (branch, source control, pull request, commit,
// changes). In "info" mode the body is the default slot, so a scene can animate what it shows there.
import { icon, fileIcon } from "../mock-icons";

export interface Entry {
  name: string;
  /** Nesting level, 0 at the root. */
  depth?: number;
  /** A folder, shown open or closed. */
  folder?: "open" | "closed";
  selected?: boolean;
  attrs?: Record<string, string>;
}
interface Props {
  mode: "files" | "info";
  files?: Entry[];
}
const { mode, files = [] } = Astro.props;
---

<aside class="m-insp">
  <div class="m-seg"><span class:list={{ on: mode === "files" }} set:html={icon("doc")} /><span class:list={{ on: mode === "info" }} set:html={icon("info")} /></div>
  {mode === "files" ? (
    <>
      <div class="m-search"><span>Filter files</span><span class="m-ic faint small" set:html={icon("refresh")} /></div>
      {files.map((file) => (
        <div {...file.attrs} class:list={["m-file", { on: file.selected }, file.attrs?.class]} style={`padding-left:${6 + (file.depth ?? 0) * 13}px`}>
          <span class:list={["m-chev", file.folder]} set:html={file.folder ? icon("chevron") : ""} />
          <span class="m-fi" set:html={fileIcon(file.name, Boolean(file.folder))} />
          <span class="m-name">{file.name}</span>
        </div>
      ))}
    </>
  ) : (
    <slot />
  )}
</aside>
