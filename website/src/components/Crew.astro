      function stir() {
        window.clearTimeout(rest); rest = window.setTimeout(sleep, 26000);
        if (asleep) { asleep = false; window.clearInterval(snores); crew.classList.remove("asleep"); members.filter(idle).forEach((one, index) => { one.pose.eyes = "n"; feel(one, { eyes: "wide", mouth: "o" }, 600); hop(one, 10, index * 60); });
          const awake = members.filter(idle).find(inSight); if (awake) window.setTimeout(() => speak(awake, any1(reactions.back), "hi"), 500); }
      }
      const look = () => {
        frame = 0;
        for (const one of members.filter(idle)) {
          const box = one.element.getBoundingClientRect(), dx = pointer.x - (box.left + box.width / 2), dy = pointer.y - (box.top + box.height * 0.55), far = Math.hypot(dx, dy);
          const side = dx < 0 ? "l" : "r", turned = one.pose.flip ? (side === "l" ? "r" : "l") : side;
          one.pose.eyes = far < box.width * 0.9 ? "happy" : Math.abs(dx) > Math.abs(dy) * 1.2 ? turned : dy < 0 ? "u" : "d";
          one.pose.mouth = far < box.width * 0.9 ? "smile" : "none";
          draw(one);
        }
      };
      document.addEventListener("pointermove", (event) => { pointer = { x: event.clientX, y: event.clientY }; stir(); if (!frame) frame = requestAnimationFrame(look); }, { passive: true });
      stir();

      // ── events on the page
      // a press: the nearest sprite starts and hops; a press on a sprite delights it, and it leaves a heart
      let presses = 0;
      document.addEventListener("pointerdown", (event) => {
        stir();
        const target = (event.target as Element | null)?.closest?.("[data-sprite]");
        const pressed = members.find((one) => one.element === target);
        if (pressed) {
          speak(pressed, reactions.pressed[presses++ % reactions.pressed.length], "laugh");
          feel(pressed, { eyes: "star", mouth: "smile", arms: "up", blush: true }, 1200);
          if (hiders.has(pressed) && pressed.state === "home") { rise(pressed, true); window.setTimeout(() => rise(pressed, false), 1300); } else { hop(pressed, 30); leave(pressed, "heart"); }
          return;
        }
        const near = members.filter(idle).map((one) => { const box = one.element.getBoundingClientRect(); return { one, far: Math.hypot(event.clientX - box.left - box.width / 2, event.clientY - box.top - box.height / 2) }; }).sort((a, b) => a.far - b.far)[0];
        if (near && near.far < 700) { feel(near.one, { eyes: "wide", mouth: "o" }, 520); hop(near.one, 14); }
      }, { passive: true });
      // the film opens or the theme changes: everyone reacts
      new MutationObserver((records) => {
        for (const record of records) {
          if (record.attributeName === "data-theater" && !document.documentElement.hasAttribute("data-theater")) { const critic = members.find(inSight); if (critic) window.setTimeout(() => speak(critic, any1(reactions.film), "yay"), 500); }
          if (record.attributeName === "data-theater" && document.documentElement.hasAttribute("data-theater")) members.forEach((one, index) => { feel(one, { eyes: "star", mouth: "smile", arms: "up", blush: true }, 1600); hop(one, 22, index * 80); });
          if (record.attributeName === "data-theme") { dye(); const witness = members.find(inSight); if (witness) window.setTimeout(() => speak(witness, any1(document.documentElement.dataset.theme === "dark" ? reactions.dark : reactions.light), "oh"), 300); }
          if (record.attributeName === "data-theme") members.forEach((one, index) => { feel(one, { eyes: "wide", mouth: "o" }, 800); hop(one, 12, index * 70); });
        }
      }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theater", "data-theme"] });
    }
  }
</script>
