# Mercury shell integration for bash, started as `bash --rcfile <this file> -i`.
# Generated by Mercury and rewritten when it changes; edit your own startup files instead.
#
# bash ignores --rcfile in a login shell, so Mercury starts an interactive shell with this file and reads what a
# login shell would: /etc/profile, then the first of ~/.bash_profile, ~/.bash_login and ~/.profile (falling back to
# ~/.bashrc when none exists). Mercury's functions come last, so a claude or codex function of your own wins.

if [ -r /etc/profile ]; then
  . /etc/profile
fi
if [ -r "$HOME/.bash_profile" ]; then
  . "$HOME/.bash_profile"
elif [ -r "$HOME/.bash_login" ]; then
  . "$HOME/.bash_login"
elif [ -r "$HOME/.profile" ]; then
  . "$HOME/.profile"
elif [ -r "$HOME/.bashrc" ]; then
  . "$HOME/.bashrc"
fi

__mercury_integration_dir="${BASH_SOURCE[0]%/*}"
if [ -r "$__mercury_integration_dir/claude-shell-function.bash" ]; then
  . "$__mercury_integration_dir/claude-shell-function.bash"
fi
if [ -r "$__mercury_integration_dir/codex-shell-function.bash" ]; then
  . "$__mercury_integration_dir/codex-shell-function.bash"
fi
unset __mercury_integration_dir
