# Mercury: `codex` runs under the Codex account selected in Mercury (zsh).
# Generated by Mercury and rewritten when it changes.
#
# Every run re-reads $MERCURY_DATA_ROOT/codex-homes/selected-host (an absolute config directory), so switching accounts
# in Mercury applies to the next `codex` without reopening the terminal. An empty or missing pointer keeps your
# default login. A CODEX_HOME you set yourself wins, and so does a codex function you defined yourself: this file then
# defines nothing. Running under a Mercury account unsets API-key variables that would override its login.
if ! typeset -f codex >/dev/null 2>&1; then
  function codex {
    local __mercury_pointer __mercury_home=""
    if [[ -n "${CODEX_HOME:-}" || -z "${MERCURY_DATA_ROOT:-}" ]]; then
      command codex "$@"
      return
    fi
    __mercury_pointer="${MERCURY_DATA_ROOT}/codex-homes/selected-host"
    if [[ -r "$__mercury_pointer" ]]; then
      __mercury_home="$(cat -- "$__mercury_pointer" 2>/dev/null)"
    fi
    if [[ -z "$__mercury_home" ]]; then
      command codex "$@"
      return
    fi
    # Refuse rather than run under the wrong account.
    if [[ "$__mercury_home" != /* ]]; then
      printf '%s\n' "mercury: the selected Codex account is not an absolute path ($__mercury_pointer); codex not started." >&2
      return 1
    fi
    # A private folder, like the one Mercury creates for an account.
    [[ -d "$__mercury_home" ]] || mkdir -p -m 700 -- "$__mercury_home" 2>/dev/null
    (
      unset OPENAI_API_KEY
      export CODEX_HOME="$__mercury_home"
      command codex "$@"
    )
  }
fi
