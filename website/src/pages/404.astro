---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found · Suijin" description="This page does not exist on suijin.app." path="/404">
  <div class="page-head" style="padding-bottom:160px" data-lost>
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>Nothing at this address</h1>
      <p>The page may have moved. <a href="/">Go to the home page</a>.</p>
    </div>
  </div>
</Base>
