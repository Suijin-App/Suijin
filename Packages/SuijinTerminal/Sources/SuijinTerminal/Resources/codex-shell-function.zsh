# Suijin: `codex` runs under the Codex account selected in Suijin (zsh).
# Generated by Suijin and rewritten when it changes.
#
# Every run re-reads $SUIJIN_DATA_ROOT/codex-homes/selected-host (an absolute config directory), so switching accounts
# in Suijin applies to the next `codex` without reopening the terminal. An empty or missing pointer keeps your
# default login. A CODEX_HOME you set yourself wins, and so does a codex function you defined yourself: this file then
# defines nothing. Running under a Suijin account unsets API-key variables that would override its login.
#
# While it runs, the tab shows Codex with its status: the run is announced to Suijin (see the shell integration's
# __suijin_agent_begin).
if ! typeset -f codex >/dev/null 2>&1; then
  function __suijin_codex_run {
    local __suijin_pointer __suijin_home=""
    if [[ -n "${CODEX_HOME:-}" || -z "${SUIJIN_DATA_ROOT:-}" ]]; then
      command codex "$@"
      return
    fi
    __suijin_pointer="${SUIJIN_DATA_ROOT}/codex-homes/selected-host"
    if [[ -r "$__suijin_pointer" ]]; then
      __suijin_home="$(cat -- "$__suijin_pointer" 2>/dev/null)"
    fi
    if [[ -z "$__suijin_home" ]]; then
      command codex "$@"
      return
    fi
    # Refuse rather than run under the wrong account.
    if [[ "$__suijin_home" != /* ]]; then
      printf '%s\n' "suijin: the selected Codex account is not an absolute path ($__suijin_pointer); codex not started." >&2
      return 1
    fi
    # A private folder, like the one Suijin creates for an account.
    [[ -d "$__suijin_home" ]] || mkdir -p -m 700 -- "$__suijin_home" 2>/dev/null
    (
      unset OPENAI_API_KEY
      export CODEX_HOME="$__suijin_home"
      command codex "$@"
    )
  }
  # Tells Suijin that codex runs in this terminal, and when it is done. The prompt hook (__suijin_agent_prompt)
  # reports the end too when Ctrl-C or a crash skipped the last line.
  function codex {
    local __suijin_status
    __suijin_agent_begin codex
    __suijin_codex_run "$@"
    __suijin_status=$?
    __suijin_agent_end "$__suijin_status"
    return "$__suijin_status"
  }
fi
