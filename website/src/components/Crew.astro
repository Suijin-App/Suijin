      // a journey to somewhere on the page that is not a post, and what to do on getting there
      const voyage = (one: Member, spot: Spot, perch: Perch | null, then?: () => void, delay = 0) => { travel(one, spot, false, perch, delay); if (then && one.state === "swim") arrivals.set(one, then); };

