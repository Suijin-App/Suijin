# Xcode — project.yml is the source of truth; Suijin.xcodeproj is generated by `xcodegen generate`.
Suijin.xcodeproj/
*.xcworkspace/xcuserdata/
*.xcuserstate
DerivedData/
build/
*.xcarchive
*.dSYM
*.dSYM.zip
*.dmg

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store
._*

# Secrets and certificates never go into the repo
.env
.env.*
!.env.example
*.p12
*.p8
*.cer
*.mobileprovision
*.provisionprofile
Config/Secrets.xcconfig


# Local logs
*.log
*.pyc
# Screenshots taken while reviewing UI work stay local (tens of MB per review).
plans/reports/**/*.png

# Local agent state; the project skills under .claude/skills are tracked.
.claude/agent-memory/
.claude/worktrees/
