# Sevinda: `codex` runs under the Codex account selected in Sevinda (zsh).
# Generated by Sevinda and rewritten when it changes.
#
# Every run re-reads $SEVINDA_DATA_ROOT/codex-homes/selected-host (an absolute config directory), so switching accounts
# in Sevinda applies to the next `codex` without reopening the terminal. An empty or missing pointer keeps your
# default login. A CODEX_HOME you set yourself wins, and so does a codex function you defined yourself: this file then
# defines nothing. Running under a Sevinda account unsets API-key variables that would override its login.
if ! typeset -f codex >/dev/null 2>&1; then
  function codex {
    local __sevinda_pointer __sevinda_home=""
    if [[ -n "${CODEX_HOME:-}" || -z "${SEVINDA_DATA_ROOT:-}" ]]; then
      command codex "$@"
      return
    fi
    __sevinda_pointer="${SEVINDA_DATA_ROOT}/codex-homes/selected-host"
    if [[ -r "$__sevinda_pointer" ]]; then
      __sevinda_home="$(cat -- "$__sevinda_pointer" 2>/dev/null)"
    fi
    if [[ -z "$__sevinda_home" ]]; then
      command codex "$@"
      return
    fi
    # Refuse rather than run under the wrong account.
    if [[ "$__sevinda_home" != /* ]]; then
      printf '%s\n' "sevinda: the selected Codex account is not an absolute path ($__sevinda_pointer); codex not started." >&2
      return 1
    fi
    # A private folder, like the one Sevinda creates for an account.
    [[ -d "$__sevinda_home" ]] || mkdir -p -m 700 -- "$__sevinda_home" 2>/dev/null
    (
      unset OPENAI_API_KEY
      export CODEX_HOME="$__sevinda_home"
      command codex "$@"
    )
  }
fi
