---
// The four water sprites of the introduction film, living on every page.
//
// On the home page each has a post of its own in the hero:
//   aqua    hides behind the "Watch the introduction" button and pops up to wave at it;
//   claude  hides behind the download button and comes up when the pointer nears it;
//   shell   stands on the scene tab that is playing and jumps to the next one when the scene changes;
//   codex   walks back and forth along the top edge of the app window.
//
// They follow the reader. When scrolling leaves a sprite out of sight, it drops into the water (the page's
// background), swims behind the content to the part now on screen, climbs onto the top edge of something real there
// (a card, a button, a picture, a heading's first line) where it covers nothing, and leaves a small sign. Scrolling
// back to the hero sends them home; on the other pages they swim in and find a place the same way.
//
// All of them blink and breathe, watch the pointer, start at a press on the page, cheer when the film opens and doze
// off when nothing moves. With reduced motion they stand still at their posts and do not travel.
import { spritePixels, type SpriteColor } from "../lib/sprite";

const crew: SpriteColor[] = ["aqua", "claude", "shell", "codex"];
---

<div class="crew" data-crew aria-hidden="true">
  {crew.map((color) => (
    <span class="crew-post" data-post={color}>
      <span class="crew-sprite" data-sprite={color}>
        <svg viewBox="0 0 12 14" shape-rendering="crispEdges" set:html={spritePixels(color)} />
      </span>
    </span>
  ))}
</div>
<button class="icon-button crew-sound" type="button" data-crew-sound aria-pressed="false" aria-label="Sprite sounds" title="Sprite sounds" hidden>
  <svg class="on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z" /><path d="M15.5 8.5a5 5 0 0 1 0 7" /><path d="M18.5 5.5a9 9 0 0 1 0 13" /></svg>
  <svg class="off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z" /><path d="m16 9 5 6" /><path d="m21 9-5 6" /></svg>
</button>

<script>
  import { animate } from "animejs";
  import { spritePixels, signSvg, type SpriteColor, type SpritePose, type SpriteSign } from "../lib/sprite";
  import { scenes, introductions, places, race, reactions, audience, type TalkLine, type TalkMood } from "../lib/crew-talk";
  import { crewSound, setSound, soundOn, soundWanted, type CrewSound } from "../lib/crew-sound";

  const crew = document.querySelector<HTMLElement>("[data-crew]");
  const water = document.querySelector<HTMLElement>("[data-touch]");
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (crew) {
    // A spot is a point on an edge, in document coordinates: where the feet go. `rest` is how far the sprite sinks
    // below the edge there (behind a button); a perch remembers the element the spot was measured on.
    type Spot = { x: number; y: number; rest: number; hides?: boolean; floats?: boolean };
    type Perch = { element: Element; at: number; line: boolean };
    type Member = { color: SpriteColor; post: HTMLElement; element: HTMLElement; svg: SVGElement; pose: SpritePose; mood: SpritePose | null;
      home: (() => Spot | null) | null; perch: Perch | null; state: "home" | "away" | "swim" | "gone"; size: number; rest: number; busy: boolean; up: boolean; walking: boolean; goal: Spot | null; floating: boolean };
    const member = (color: SpriteColor): Member => {
      const post = crew.querySelector<HTMLElement>(`[data-post="${color}"]`)!, element = post.querySelector<HTMLElement>("[data-sprite]")!;
      return { color, post, element, svg: element.querySelector("svg") as SVGElement, pose: {}, mood: null, home: null, perch: null, state: "gone", size: 4, rest: 0, busy: false, up: false, walking: false, goal: null, floating: false };
    };
    const aqua = member("aqua"), claude = member("claude"), shell = member("shell"), codex = member("codex");
    const members = [aqua, claude, shell, codex];

    // ── measures
    let pixel = 4;
    const tall = () => 14 * pixel, wide = () => 12 * pixel;
    const page = (rect: DOMRect, at: number, rest = 0, hides = false): Spot => ({ x: rect.left + rect.width * at + window.scrollX, y: rect.top + 1 + window.scrollY, rest, hides });
    // each sprite has its own pixel size: the two that hide behind the buttons are a size smaller there, to fit the gap above them
    const resize = (one: Member, size: number) => { one.size = size; one.post.style.setProperty("--sprite", `${size}px`); };
    const stand = (one: Member, x: number, y: number) => { one.post.style.left = `${x - 9 * one.size}px`; one.post.style.top = `${y - 42 * one.size}px`; };
    const feet = (one: Member) => ({ x: one.post.offsetLeft + 9 * one.size, y: one.post.offsetTop + 42 * one.size });
    const small = () => Math.min(3, pixel);
    const line = () => Math.round(14 * pixel * 0.34);           // how far above its feet the water reaches on a swimmer
    const onScreen = (y: number) => { const top = y - window.scrollY; return top - tall() > 84 && top < window.innerHeight - 6; };

    // ── the posts in the hero (home page only)
    const hero = document.querySelector<HTMLElement>(".hero");
    const stage = hero?.querySelector<HTMLElement>("[data-stage]");
    const appWindow = stage?.querySelector<HTMLElement>(".mac");
    const tabsRow = stage?.querySelector<HTMLElement>(".scene-tabs");
    const filmButton = hero?.querySelector<HTMLElement>(".actions [data-film-open]");
    const downloadButton = hero?.querySelector<HTMLElement>(".actions .button.primary");
    const activeTab = () => tabsRow?.querySelector<HTMLElement>('[aria-selected="true"]') ?? tabsRow?.querySelector<HTMLElement>("[data-scene]") ?? null;
    const hiders = new Map<Member, HTMLElement>();
    // the stretch of the window's top edge the walker may use: to the right of the row of tabs
    const patrol = () => {
      if (!appWindow || !tabsRow) return null;
      const frame = appWindow.getBoundingClientRect(), tabs = tabsRow.getBoundingClientRect();
      const from = Math.max(tabs.right + 10 * pixel, frame.left + frame.width * 0.5), to = frame.right - 12 * pixel;
      return { from: from + window.scrollX, to: to + window.scrollX, y: frame.top + 1 + window.scrollY, room: to - from > 16 * pixel, end: frame.right - 14 * pixel + window.scrollX };
    };
    if (hero && appWindow && tabsRow && filmButton && downloadButton) {
      // under a third of a hider stays below the button's edge: the eyes are always above it
      aqua.home = () => page(filmButton.getBoundingClientRect(), 0.84, Math.round(14 * small() * 0.3), true);
      claude.home = () => page(downloadButton.getBoundingClientRect(), 0.16, Math.round(14 * small() * 0.3), true);
      shell.home = () => { const tab = activeTab(); return tab ? { ...page(tab.getBoundingClientRect(), 0.5), y: tabsRow.getBoundingClientRect().top + 1 + window.scrollY } : null; };
      codex.home = () => { const road = patrol(); if (!road) return null;
        return { x: road.room ? Math.min(Math.max(codex.state === "home" ? feet(codex).x : road.to, road.from), road.to) : road.end, y: road.y, rest: 0 }; };
      hiders.set(aqua, filmButton); hiders.set(claude, downloadButton);
    }

    // ── places to stand elsewhere: the top edge of something real, where the sprite covers nothing
    const structural = new Set(["HTML", "BODY", "MAIN", "SECTION", "ARTICLE", "FOOTER", "DIV"]);
    const backdrop = (node: Element | null): boolean => {
      if (!node || node.closest("[data-crew]")) return true;
      if (!structural.has(node.tagName)) return false;
      for (const child of node.childNodes) if (child.nodeType === Node.TEXT_NODE && child.textContent?.trim()) return false;
      if (node.tagName !== "DIV" && node.tagName !== "ARTICLE") return true;
      if (node.getBoundingClientRect().width >= window.innerWidth * 0.9) return true;   // a band across the page is still water
      const paint = getComputedStyle(node);
      return paint.backgroundImage === "none" && /rgba?\(\s*\d+,\s*\d+,\s*\d+,\s*0\s*\)|transparent/.test(paint.backgroundColor);
    };
    const clear = (x: number, top: number): boolean => {
      for (const dx of [-0.42, 0, 0.42]) for (const dy of [-16, 4, tall() / 2, tall() - 5]) if (!backdrop(document.elementFromPoint(x + dx * wide(), top - tall() + dy))) return false;
      return true;
    };
    const edgeOf = (perch: Perch): DOMRect | null => {
      if (!perch.element.isConnected) return null;
      if (!perch.line) return perch.element.getBoundingClientRect();
      const range = document.createRange(); range.selectNodeContents(perch.element);
      return range.getClientRects()[0] ?? null;                 // a heading's first line, not its whole block
    };
    const perches = (): { perch: Perch; x: number; y: number }[] => {
      const found: { perch: Perch; x: number; y: number }[] = [];
      for (const element of document.querySelectorAll("main :is(h1, h2, h3, .card, .link-card, .button, .chip, img, pre, table, details, figure, blockquote, p, li)")) {
        if (element.closest(".hero, .crew, [hidden]")) continue;
        const line = /^(H\d|P|LI)$/.test(element.tagName), edge = edgeOf({ element, at: 0, line });
        if (!edge || edge.width < 70 || edge.height < 14 || edge.top - tall() < 86 || edge.top > window.innerHeight - 10) continue;
        for (const at of [0.88, 0.12, 0.7, 0.3, 0.5]) {
          const x = edge.left + edge.width * at;
          if (x - wide() / 2 < 8 || x + wide() / 2 > window.innerWidth - 8 || !clear(x, edge.top)) continue;
          found.push({ perch: { element, at, line }, x: x + window.scrollX, y: edge.top + 1 + window.scrollY });   // one edge can hold several
        }
      }
      return found;
    };

    // Open water on screen, for when there is nothing to stand on: points near the sides where a swimmer covers nothing.
    const pools = (): { x: number; y: number }[] => {
      const found: { x: number; y: number }[] = [];
      for (const fy of [0.3, 0.44, 0.58, 0.72, 0.86]) for (let fx = 0.06; fx < 0.96; fx += 0.08) {
        const x = window.innerWidth * fx, y = window.innerHeight * fy;
        if (y - tall() > 86 && x - wide() / 2 > 8 && x + wide() / 2 < window.innerWidth - 8 && clear(x, y)) found.push({ x: x + window.scrollX, y: y + window.scrollY });
      }
      return found;
    };

    // ── looks: where the eyes point, overlaid by a mood that lasts a while
    const draw = (one: Member) => {
      const pose = { ...one.pose, ...(one.mood ?? {}) }, key = JSON.stringify(pose);
      if (one.element.dataset.pose !== key) { one.element.dataset.pose = key; one.svg.innerHTML = spritePixels(one.color, pose); }
    };
    const moods = new Map<Member, number>();
    const feel = (one: Member, mood: SpritePose, time = 900) => {
      one.mood = mood; draw(one);
      window.clearTimeout(moods.get(one));
      if (time > 0) moods.set(one, window.setTimeout(() => { one.mood = null; draw(one); }, time));
    };

    // ── keeping everyone where they belong when the layout changes
    const settle = (one: Member) => { if (!one.busy && !one.up && one.state !== "swim") one.element.style.transform = `translateY(${one.rest}px)`; };
    const place = () => {
      pixel = window.innerWidth < 560 ? 3 : 4;
      for (const one of members) {
        if (one.state !== "swim") resize(one, one.state === "home" && hiders.has(one) ? small() : pixel);
        if (one.state === "home" && one.home) { const spot = one.home(); if (spot && !(one === codex && one.walking) && !(one === shell && one.busy)) { stand(one, spot.x, spot.y); one.rest = spot.rest; } }
        if (one.state === "away" && one.perch) { const edge = edgeOf(one.perch); if (edge) stand(one, edge.left + edge.width * one.perch.at + window.scrollX, edge.top + 1 + window.scrollY); }
        settle(one);
      }
    };

    if (calm) {
      // no motion: the sprites that have a post on this page stand at it
      crew.classList.add("still");
      for (const one of members) if (one.home) { one.state = "home"; one.post.classList.add("posted"); if (hiders.has(one)) one.post.classList.add("hides"); }
      place(); members.forEach(draw);
      new ResizeObserver(place).observe(document.body);
    } else {
      crew.classList.add("alive");
      members.forEach((one) => { one.post.style.opacity = "0"; });
      let asleep = false;
      // ── sound: each sprite has its own voice; what is out of sight is not heard
      const play = (name: CrewSound, one?: Member, step = 0) => {
        if (!soundOn() || document.hidden) return;
        if (one) { const top = feet(one).y - window.scrollY; if (top < 0 || top > window.innerHeight + 40) return; }
        crewSound(name, one?.color ?? "aqua", step);
      };
      const crewSoundAt = (name: CrewSound, one?: Member) => { if (soundOn() && !document.hidden) crewSound(name, one?.color ?? "aqua"); };
      const speaker = document.querySelector<HTMLButtonElement>("[data-crew-sound]");
      if (speaker) {
        speaker.hidden = false;
        const show = () => speaker.setAttribute("aria-pressed", String(soundOn()));
        speaker.addEventListener("click", () => { setSound(!soundOn()); show(); play("cheer"); });
        if (soundWanted()) { setSound(true); show(); }
      }
      // ── water
      // Water is drawn the way the sprites are, in square pixels, but it moves like water: every fleck is a particle
      // with a velocity. Foam on the surface is slowed by drag and fades; drops in the air fall under gravity and, back
      // on the surface, leave a small ripple. One canvas over the screen, above the page's bands and below its content.
      type Fleck = { x: number; y: number; vx: number; vy: number; age: number; life: number; light: boolean; floor: number | null };
      const sea = document.createElement("canvas"), ink = sea.getContext("2d");
      const flecks: Fleck[] = [], gravity = 900, drag = 3.2;
      // the blues of the rings in the app icon, as the stylesheet gives them for the theme in use
      let tints = ["", ""];
      const dye = () => { const paint = getComputedStyle(crew); tints = [paint.getPropertyValue("--foam").trim(), paint.getPropertyValue("--foam-light").trim()]; };
      let running = 0, ticked = 0;
      sea.className = "crew-sea"; crew.append(sea);
      const fit = () => { const ratio = window.devicePixelRatio || 1; sea.width = window.innerWidth * ratio; sea.height = window.innerHeight * ratio; ink?.setTransform(ratio, 0, 0, ratio, 0, 0); };
      const any = (spread: number) => (Math.random() - 0.5) * 2 * spread;
      const fleck = (x: number, y: number, vx: number, vy: number, life: number, light = Math.random() < 0.4, floor: number | null = null) => {
        if (flecks.length > 420) flecks.shift();
        flecks.push({ x, y, vx, vy, age: 0, life, light, floor });
        if (!running) { ticked = performance.now(); running = requestAnimationFrame(flow); }
      };
      function flow(now: number) {
        const dt = Math.min(0.05, (now - ticked) / 1000), slow = Math.exp(-drag * dt); ticked = now;
        if (!ink) return;
        ink.clearRect(0, 0, window.innerWidth, window.innerHeight);
        for (let index = flecks.length - 1; index >= 0; index--) {
          const one = flecks[index];
          one.age += dt; one.x += one.vx * dt; one.y += one.vy * dt;
          if (one.floor === null) { one.vx *= slow; one.vy *= slow; }
          else {
            one.vy += gravity * dt;
            if (one.vy > 0 && one.y >= one.floor) {              // a drop lands: a ripple runs off to both sides
              flecks.splice(index, 1);
              for (const way of [-1, 1]) fleck(one.x, one.floor, way * (26 + Math.random() * 22), any(4), 0.45 + Math.random() * 0.3, one.light);
              continue;
            }
          }
          if (one.age >= one.life) { flecks.splice(index, 1); continue; }
          // four steps of fading, and whole pixels only
          ink.globalAlpha = one.floor === null ? 1 - Math.floor((one.age / one.life) * 4) / 4 : 1;
          ink.fillStyle = tints[one.light ? 1 : 0];
          ink.fillRect(Math.round(one.x / pixel) * pixel - window.scrollX, Math.round(one.y / pixel) * pixel - window.scrollY, pixel, pixel);
        }
        running = flecks.length ? requestAnimationFrame(flow) : 0;
        if (!running) ink.clearRect(0, 0, window.innerWidth, window.innerHeight);
      }
      fit(); dye(); window.addEventListener("resize", fit, { passive: true });
      // Going in or coming out: a crown of drops thrown up and outwards, and a ring of foam pushed away on the surface.
      const splash = (x: number, y: number, force = 1, one?: Member) => {
        if (y > window.scrollY && y < window.scrollY + window.innerHeight) crewSoundAt("splash", one);
        for (let drop = 0; drop < 16 * force; drop++) fleck(x + any(8), y - 2, any(150) * force, -(150 + Math.random() * 210) * force, 2, undefined, y + any(3));
        for (let wave = 0; wave < 14; wave++) { const turn = (wave / 14) * Math.PI * 2; fleck(x + Math.cos(turn) * 8, y + Math.sin(turn) * 3, Math.cos(turn) * 95 * force, Math.sin(turn) * 34 * force, 0.7 + Math.random() * 0.3); }
      };
      // The wake of a swimmer moving at `speed` along (ux, uy): the water it parts is thrown to both sides and drag
      // slows it, so the two arms open into a V behind; churned foam is left in between, and a small bow wave runs ahead.
      const wake = (x: number, y: number, ux: number, uy: number, speed: number) => {
        // the faster it swims, the sooner its foam is gone: the trail stays about as long as two sprites, never a streak
        const push = 70 + speed * 0.3, lasts = Math.min(0.6, Math.max(0.16, 90 / (speed || 1)));
        for (const way of [-1, 1]) fleck(x - uy * way * pixel, y + ux * way * pixel, -uy * way * push - ux * speed * 0.1 + any(5), ux * way * push - uy * speed * 0.1 + any(5), lasts * (0.8 + Math.random() * 0.4));
        fleck(x - ux * pixel + any(3), y - uy * pixel + any(3), any(9) - ux * 12, any(9) - uy * 12, lasts * (0.5 + Math.random() * 0.3), true);
        if (Math.random() < 0.5) { const way = Math.random() < 0.5 ? -1 : 1; fleck(x + ux * 7 * pixel, y + uy * 7 * pixel, ux * speed * 0.45 - uy * way * 18, uy * speed * 0.45 + ux * way * 18, 0.3); }
      };
      // An arm coming out of the water flicks a few drops backwards.
      const spray = (x: number, y: number, ux: number) => { for (let drop = 0; drop < 3; drop++) fleck(x, y - 2, -ux * (40 + Math.random() * 70), -(90 + Math.random() * 90), 2, undefined, y + any(2)); };

      // ── moves
      // A hop from wherever the sprite rests: crouch, leap, land with a squash.
      const hop = (one: Member, height = 20, delay = 0) => {
        if (one.busy || one.up || one.floating || one.state === "swim" || one.state === "gone") return;
        one.busy = true;
        window.setTimeout(() => play("hop", one), delay);
        const rest = one.rest;
        animate(one.element, {
          y: [{ to: rest, duration: 90 }, { to: rest - height, duration: 210, ease: "outQuad" }, { to: rest, duration: 230, ease: "inQuad" }],
          scaleY: [{ to: 0.84, duration: 90, ease: "outQuad" }, { to: 1.1, duration: 210, ease: "outQuad" }, { to: 1, duration: 150 }, { to: 0.87, duration: 80 }, { to: 1, duration: 260, ease: "outElastic(1, .5)" }],
          scaleX: [{ to: 1.1, duration: 90, ease: "outQuad" }, { to: 0.95, duration: 210, ease: "outQuad" }, { to: 1, duration: 150 }, { to: 1.09, duration: 80 }, { to: 1, duration: 260, ease: "outElastic(1, .5)" }],
          delay,
          onComplete: () => { one.busy = false; },
        });
      };
      // A hider comes all the way up from behind its button, or sinks back.
      const rise = (one: Member, up: boolean) => {
        if (one.up === up || one.state !== "home") return;
        one.up = up; if (up) play("peek", one);
        animate(one.element, { y: up ? 0 : one.rest, scaleY: up ? [0.9, 1.06, 1] : 1, duration: up ? 420 : 300, ease: up ? "outBack(2)" : "inOutQuad" });
      };
      // A small sign floats up from a sprite's head.
      let signs = 0;
      const leave = (one: Member, sign?: SpriteSign) => {
        const mark = document.createElement("span");
        mark.className = "crew-sign"; mark.innerHTML = signSvg(sign ?? (["heart", "star", "note", "check", "spark", "wave"] as SpriteSign[])[signs++ % 6], Math.max(2, pixel - 1));
        one.post.append(mark);
        if (sign === "zzz") play("snore", one); else if (sign !== "note") play("pop", one);
        animate(mark, { y: [8, -14], opacity: [{ to: 1, duration: 220 }, { to: 1, duration: 900 }, { to: 0, duration: 480 }], duration: 1600, ease: "outQuad", onComplete: () => mark.remove() });
      };

      // ── talk: a speech bubble over a sprite's head, in a layer above the page so it shows even over a swimmer, and
      //    the sprite's voice with it
      const bubbles = new Map<Member, HTMLElement>();
      let following = 0, talking = false, chase = { left: 0, first: true, rushed: false };
      const any1 = (lines: string[]) => lines[Math.floor(Math.random() * lines.length)];
      const inSight = (one: Member) => { const top = feet(one).y - window.scrollY; return one.state !== "gone" && top > 90 && top < window.innerHeight + 10; };
      const follow = () => {
        following = 0;
        for (const [one, bubble] of bubbles) {
          const here = feet(one), half = bubble.offsetWidth / 2, low = window.scrollX + 8 + half, high = window.scrollX + window.innerWidth - 8 - half;
          const x = Math.min(Math.max(here.x, low), Math.max(low, high));
          bubble.style.left = `${x}px`; bubble.style.top = `${here.y - 14 * one.size - (one.state === "swim" || one.floating ? 0 : 8)}px`;
          bubble.style.setProperty("--tail", `${here.x - x}px`);
        }
        if (bubbles.size) following = requestAnimationFrame(follow);
      };
      const speak = (one: Member, words: string, mood: TalkMood = "chat", time = 0) => {
        if (!inSight(one) || document.hidden) return;
        bubbles.get(one)?.remove();
        const bubble = document.createElement("span");
        bubble.className = "crew-say"; bubble.textContent = words;
        crew.append(bubble); bubbles.set(one, bubble);
        if (!following) follow();
        play(mood === "yay" ? "cheer" : mood, one);
        if (!one.busy && one.state !== "swim") feel(one, { mouth: "open", eyes: mood === "yay" ? "happy" : mood === "oh" ? "wide" : undefined, arms: mood === "yay" || mood === "hi" ? "wave" : undefined }, 620);
        window.setTimeout(() => { if (bubbles.get(one) !== bubble) return; bubbles.delete(one); bubble.classList.add("leaves"); window.setTimeout(() => bubble.remove(), 220); }, time || 1500 + words.length * 38);
      };
      // a scene: its lines one after another, each spoken by a member of the cast
      const converse = (cast: Member[], lines: TalkLine[]) => {
        talking = true;
        let at = 0;
        for (const [who, words, mood] of lines) { window.setTimeout(() => { if (!asleep) speak(cast[who % cast.length], words, mood); }, at); at += 1250 + words.length * 34; }
        window.setTimeout(() => { talking = false; }, at + 600);
      };

      // Coming down on an edge: a squash, a shake to get dry, then a sign (or, behind a button, sinking into hiding).
      const land = (one: Member, spot: Spot, home: boolean, perch: Perch | null) => {
        one.state = home ? "home" : "away"; one.goal = null; one.perch = perch; one.pose = {}; draw(one);
        if (home && spot.hides) resize(one, small());
        stand(one, spot.x, spot.y); play("land", one); play("shake", one);
        // landing: a squash, a shake to get dry, then a sign (or, behind a button, sinking into hiding)
        animate(one.element, { scaleY: [0.82, 1.06, 1], scaleX: [1.14, 0.96, 1], rotate: [0, -9, 8, -6, 4, 0], duration: 620, ease: "outQuad" });
        feel(one, { eyes: "shut", mouth: "smile" }, 520);
        window.setTimeout(() => {
