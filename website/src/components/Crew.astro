          one.rest = 0; resize(one, pixel); stand(one, from.x, from.y); one.post.style.opacity = "1";
          animate(one.element, { y: 0, scaleX: 1, scaleY: 1, rotate: 0, opacity: 1, duration: 0 });
          one.pose = { flip: side < 0, legs: "tuck", arms: "up", eyes: "u" }; draw(one); play("leap", one);
          splash(from.x, from.y - line(), 0.9, one);
          animate(state, { p: 1, duration: 540, ease: "linear",
            onUpdate: () => stand(one, from.x + (spot.x - from.x) * state.p, from.y + (spot.y - from.y) * state.p - Math.sin(state.p * Math.PI) * 58),
            onComplete: () => land(one, spot, home, perch) });
        }, delay);
      };

      // Several swimming off together is a race, which `land` settles: the first to arrive gloats, the last complains.
      const contest = (racers: Member[], rushed = false) => {
        chase = { left: racers.length, first: true, rushed };
        // said once they have swum into view: whoever is furthest from where it is going is the one behind
        const left = (one: Member) => (one.goal ? Math.hypot(one.goal.x - feet(one).x, one.goal.y - feet(one).y) : 0);
        window.setTimeout(() => { const seen = racers.filter((one) => one.state === "swim" && inSight(one)).sort((p, q) => left(p) - left(q));
          if (seen.length > 1) { speak(seen[seen.length - 1], any1(race.behind), "ask"); window.setTimeout(() => speak(seen[0], any1(race.ahead), "laugh"), 800); } }, 1000);
        window.setTimeout(() => { chase.left = 0; }, 9000);
      };

      // Who is out of sight goes to the reader: home if its post is on screen, otherwise to a free edge in view.
      let lastRoam = window.scrollY;
      const roam = () => {
        if (document.hidden || away) return;
        const taken: { x: number; y: number }[] = [], movers: Member[] = [];
        for (const one of members) {
          if (one.state === "swim") { if (one.goal) taken.push(one.goal); continue; }   // its place is spoken for
          const spot = one.home?.() ?? null;
          if (spot && onScreen(spot.y)) { if (one.state === "home") taken.push(spot); else movers.push(one); continue; }
          const here = feet(one);
          // a place to stand is still sought for whoever treads water, unless it is in the water as part of a game
          if (one.state === "away" && onScreen(here.y) && (!one.floating || acting.has(one))) taken.push(here); else movers.push(one);
        }
        if (!movers.length) return;
        // several setting off together is a race: the one at the back calls out, the one in front teases
        const racers = movers.filter((one) => one.state !== "gone");
        if (racers.length > 1) {
          contest(racers, Math.abs(window.scrollY - lastRoam) > window.innerHeight * 2.2);
        }
        lastRoam = window.scrollY;
        const open = perches();
        movers.forEach((one, index) => {
          const spot = one.home?.() ?? null;
          if (spot && onScreen(spot.y)) { taken.push(spot); if (one.state === "gone") appear(one, spot, true, null, index * 160); else travel(one, spot, true, null, index * 240); return; }
          const here = one.state === "gone" ? { x: window.scrollX + window.innerWidth / 2, y: window.scrollY + window.innerHeight / 2 } : feet(one);
          // a sprite on its way takes the nearest free edge; one that is just arriving at the page takes any of them
          const free = open.filter((place) => taken.every((other) => Math.hypot(other.x - place.x, other.y - place.y) > wide() * 2.4));
          const choice = one.state === "gone" ? free[Math.floor(Math.random() * free.length)]
            : free.sort((p, q) => Math.hypot(p.x - here.x, p.y - here.y) - Math.hypot(q.x - here.x, q.y - here.y))[0];
          if (!choice) {                                        // nowhere to stand here: open water will do
            if (one.floating && onScreen(here.y)) { taken.push(here); return; }
            // the free water nearest to the others, so nobody is left alone at the far side of the screen
            const middle = taken.length ? { x: taken.reduce((sum, other) => sum + other.x, 0) / taken.length, y: taken.reduce((sum, other) => sum + other.y, 0) / taken.length }
              : { x: window.scrollX + window.innerWidth / 2, y: window.scrollY + window.innerHeight / 2 };
            const pool = pools().filter((place) => taken.every((other) => Math.hypot(other.x - place.x, other.y - place.y) > wide() * 2.4))
              .sort((p, q) => Math.hypot(p.x - middle.x, p.y - middle.y) - Math.hypot(q.x - middle.x, q.y - middle.y))[0];
            if (pool) { taken.push(pool); travel(one, { ...pool, rest: 0, floats: true }, false, null, index * 240); }
            return;
          }
          taken.push(choice);
          if (one.state === "gone") appear(one, { x: choice.x, y: choice.y, rest: 0 }, false, choice.perch, index * 160);
          else travel(one, { x: choice.x, y: choice.y, rest: 0 }, false, choice.perch, index * 240);
        });
      };

      // ── life at the posts in the hero
      // the shell sprite jumps to the tab that is now playing
      const ride = () => {
        const spot = shell.home?.();
        if (!spot || shell.state !== "home" || shell.busy) return;
        const here = feet(shell), far = Math.abs(spot.x - here.x);
        if (far < 2) return;
        shell.busy = true; play("leap", shell);
        const time = Math.min(620, 320 + far * 0.9), left = spot.x < here.x;
        feel(shell, { eyes: left ? "l" : "r", legs: "tuck", arms: "up" }, time);
        animate(shell.post, { left: `${spot.x - 9 * shell.size}px`, duration: time, ease: "inOutQuad" });
        animate(shell.element, {
          y: [{ to: -Math.min(46, 18 + far * 0.12), duration: time * 0.5, ease: "outQuad" }, { to: 0, duration: time * 0.5, ease: "inQuad" }],
          scaleY: [{ to: 1.1, duration: time * 0.5 }, { to: 1, duration: time * 0.4 }, { to: 0.86, duration: 80 }, { to: 1, duration: 240, ease: "outElastic(1, .5)" }],
          onComplete: () => { shell.busy = false; feel(shell, { eyes: "happy", mouth: "smile" }, 700); },
        });
      };
      // the codex sprite walks to a point on the window's edge, stops to look around, and sets off again
      const walk = () => {
        const road = patrol();
        if (!road || !road.room || codex.state !== "home" || asleep || codex.busy || document.hidden) { window.setTimeout(walk, 2400); return; }
        const here = feet(codex).x, span = road.to - road.from;
        let there = road.from + span * ((Math.sin(Date.now() / 3100) + 1) / 2);
        if (Math.abs(there - here) < span * 0.25) there = here < road.from + span / 2 ? road.to : road.from;
        codex.walking = true; codex.pose = { flip: there < here, eyes: "n", legs: "walkA" }; draw(codex);
        stride = window.setInterval(() => { codex.pose.legs = codex.pose.legs === "walkA" ? "walkB" : "walkA"; draw(codex); play("step", codex); }, 150);
        stroll = animate(codex.post, { left: `${there - 9 * codex.size}px`, duration: Math.abs(there - here) * 26, ease: "linear",
          onComplete: () => { window.clearInterval(stride); codex.walking = false; codex.pose.legs = "stand"; draw(codex); window.setTimeout(walk, 2200 + (Date.now() % 2600)); } });
      };
      // the two hiders come up for a look now and then; the guide waves at its button
      const peek = (one: Member, every: number, mood: SpritePose, lines: string[]) => {
        let turns = 0;
        const turn = () => {
          if (one.state === "home" && !asleep && !playing && !one.up && !one.busy && !document.hidden) {
            rise(one, true); feel(one, mood, 2300); speak(one, lines[turns++ % lines.length], "yay", 2100);    // up it comes, with its pitch
            window.setTimeout(() => { if (!hiders.get(one)?.matches(":hover, :focus-visible")) rise(one, false); }, 2400);
          }
          window.setTimeout(turn, every + (Date.now() % 3000));
        };
        window.setTimeout(turn, every * 0.7);
      };
      // a pointer on a button brings its sprite up, delighted, for as long as it stays
      hiders.forEach((button, one) => {
        const come = () => { if (one.state !== "home") return; stir(); if (!one.up) speak(one, any1(one === claude ? pitches.download : pitches.film), "yay"); rise(one, true); feel(one, { eyes: "star", mouth: "smile", arms: "up", blush: true }, 0); };
        const go = () => { if (one.state !== "home") return; one.mood = null; draw(one); rise(one, false); };
        button.addEventListener("pointerenter", come); button.addEventListener("focus", come);
        button.addEventListener("pointerleave", go); button.addEventListener("blur", go);
      });

      // ── arrival: at their posts if those are on screen, otherwise swimming in
      place();
      members.forEach((one, index) => {
        const spot = one.home?.() ?? null;
        if (!spot || !onScreen(spot.y)) return;
        appear(one, spot, true, null, 500 + index * 160);
      });
      members.forEach(draw);
      // ── shooing: the button sends everyone swimming off the nearest side of the screen, out of sight; pressed again,
      // they come back to the part on screen
      const shoo = document.querySelector<HTMLButtonElement>("[data-crew-shoo]");
      if (shoo) {
        shoo.hidden = false;
        markShoo(shoo, away);
        let clearing = 0;
        const vanish = (one: Member) => {
          window.clearInterval(bobs.get(one)); one.floating = false; one.state = "gone"; one.goal = null; one.perch = null;
          one.post.classList.remove("swims"); one.post.style.opacity = "0";
        };
        shoo.addEventListener("click", () => {
          window.clearInterval(clearing);
          if (away) {
            away = false; setAway(false); markShoo(shoo, false);
            roam();
            window.setTimeout(() => { const back = members.find((one) => inSight(one)); if (back) speak(back, any1(["We're back!", "Miss us?", "Told you we'd be back."]), "yay"); }, 1800);
            return;
          }
          const seen = members.filter((one) => inSight(one));
          if (seen.length) speak(seen[Math.floor(Math.random() * seen.length)], any1(["Okay, okay. Leaving!", "Shoo? Rude.", "Back to the water.", "Call us if you need us."]), "oh");
          away = true; setAway(true); markShoo(shoo, true);
          members.forEach((one, index) => {
            if (one.state === "gone") return;
            const here = feet(one), left = here.x - window.scrollX < window.innerWidth / 2;
            travel(one, { x: window.scrollX + (left ? -70 : window.innerWidth + 70), y: here.y + 30, rest: 0, floats: true }, false, null, 500 + index * 180, true);
          });
          // once a sprite treads water off the screen it is taken away; whoever is still about after a while goes too
          const since = Date.now();
          clearing = window.setInterval(() => {
            for (const one of members) if (one.state !== "gone" && ((one.state === "away" && one.floating) || Date.now() - since > 9000)) vanish(one);
            if (members.every((one) => one.state === "gone")) window.clearInterval(clearing);
          }, 250);
        });
      }
      window.setTimeout(roam, 300);
      // whoever is left treading water keeps looking for an edge that has come free
      window.setInterval(() => { if (members.some((one) => one.floating)) roam(); }, 5000);
      window.setTimeout(walk, 3200);
      peek(aqua, 11000, { eyes: "happy", mouth: "smile", arms: "wave" }, pitches.film);
      peek(claude, 8000, { eyes: "happy", mouth: "smile", arms: "wave" }, pitches.download);
      if (tabsRow) new MutationObserver(ride).observe(tabsRow, { attributes: true, attributeFilter: ["aria-selected"], subtree: true });
      new ResizeObserver(place).observe(document.body);
      document.fonts?.ready.then(place);
      // scrolling: once it stops, whoever was left behind follows
      let scrolled = 0;
      window.addEventListener("scroll", () => { window.clearTimeout(scrolled); scrolled = window.setTimeout(roam, 420); }, { passive: true });
      window.addEventListener("resize", () => { window.clearTimeout(scrolled); scrolled = window.setTimeout(roam, 600); }, { passive: true });

      // ── pastimes: standing in one place for a while, a sprite sings, practises its kung fu or paces along its edge
      // An act is a list of frames for one sprite or for several, each shown a while after the one before. A journey that
      // one of the cast starts meanwhile ends it for all of them; `after` runs whether it was played out or cut short.
      type Frame = [number, () => void];
      let turns = 0, playing = false;
      const shift = (one: Member, pixels: number) => { one.post.style.marginLeft = `${pixels * one.size}px`; };
      const act = (cast: Member[], script: (live: () => boolean) => Frame[], after?: () => void) => {
        const id = ++turns; let at = 0, over = false;
        const live = () => !over && cast.every((one) => acting.get(one) === id);
        const end = () => {
          if (over) return;
          over = true;
          for (const one of cast) if (acting.get(one) === id) { acting.delete(one); one.busy = false; one.mood = null; shift(one, 0); draw(one); if (one === shell) ride(); }
          after?.();
        };
        for (const one of cast) { acting.set(one, id); one.busy = true; }
        for (const [wait, show] of script(live)) { at += wait; window.setTimeout(() => { if (live()) show(); else end(); }, at); }
        window.setTimeout(end, at + 260);
      };
      const perform = (one: Member, frames: Frame[]) => act([one], () => frames);
      // several lists of frames run side by side as one, each starting `lag` later than the one before
      const weave = (lists: Frame[][], lag: number): Frame[] => {
        const all: Frame[] = [];
        lists.forEach((frames, index) => { let at = index * lag; for (const [wait, show] of frames) { at += wait; all.push([at, show]); } });
        all.sort((p, q) => p[0] - q[0]);
        let last = 0;
        return all.map(([at, show]): Frame => { const wait = at - last; last = at; return [wait, show]; });
      };
      const tune = (one: Member, beat: number) => {
        feel(one, { eyes: beat % 4 === 3 ? "happy" : "shut", mouth: beat % 2 ? "o" : "open", arms: beat % 2 ? "wave" : "up", blush: true }, 0);
        shift(one, beat % 2 ? 1 : -1); play("note", one, beat); if (beat % 3 === 0) leave(one, "note");
      };
      const song = (one: Member): Frame[] => [0, 1, 2, 3, 4, 5, 6, 7].map((beat) => [beat ? 300 : 0, () => tune(one, beat)]);
      const sing = (one: Member) => perform(one, song(one));
      const kata = (one: Member): Frame[] => {
        const guard: SpritePose = { legs: "stance", arms: "guard", eyes: "r" }, left = { flip: true };
        return [
          [0, () => feel(one, guard, 0)],
          [320, () => { feel(one, { ...guard, arms: "punch", mouth: "open" }, 0); play("punch", one); shift(one, 1); }], [170, () => { feel(one, guard, 0); shift(one, 0); }],
          [150, () => { feel(one, { ...guard, arms: "punch", mouth: "open" }, 0); play("punch", one); shift(one, 1); }], [170, () => { feel(one, guard, 0); shift(one, 0); }],
          [220, () => { feel(one, { ...guard, legs: "kick", mouth: "open", eyes: "wide" }, 0); play("kick", one); shift(one, 2); }], [260, () => { feel(one, guard, 0); shift(one, 0); }],
          [260, () => feel(one, { ...guard, ...left }, 0)],
          [220, () => { feel(one, { ...guard, ...left, arms: "punch", mouth: "open" }, 0); play("punch", one); shift(one, -1); }], [170, () => { feel(one, { ...guard, ...left }, 0); shift(one, 0); }],
          [220, () => { feel(one, { ...guard, ...left, legs: "kick", mouth: "open", eyes: "wide" }, 0); play("kick", one); shift(one, -2); }], [260, () => { feel(one, { ...guard, ...left }, 0); shift(one, 0); }],
          [300, () => { feel(one, { eyes: "happy", mouth: "smile", arms: "up", blush: true }, 0); play("cheer", one); leave(one, "spark"); }], [700, () => {}],
        ];
      };
      const fight = (one: Member) => perform(one, kata(one));
      // a few steps along the edge it stands on and back, if the way is free
      const paces = (one: Member): Frame[] | null => {
        const edge = one.perch && edgeOf(one.perch);
        if (!edge || one.state !== "away") return null;
        const here = feet(one), way = one.perch!.at < 0.5 ? 1 : -1, steps = Math.min(8, Math.floor(edge.width * 0.3 / (2 * one.size)));
        const far = here.x + way * steps * 2 * one.size;
        if (steps < 3 || !clear(far - window.scrollX, edge.top) || !clear((here.x + far) / 2 - window.scrollX, edge.top)) return null;
        if (members.some((other) => other !== one && Math.hypot(feet(other).x - far, feet(other).y - here.y) < wide() * 1.8)) return null;
        const frames: Frame[] = [];
        const stride = (count: number, toward: number) => frames.push([150, () => { feel(one, { flip: toward < 0, eyes: "n", legs: count % 2 ? "walkA" : "walkB" }, 0); play("step", one); }]);
        for (let step = 1; step <= steps; step++) { stride(step, way); frames.push([0, () => shift(one, way * step * 2)]); }
        frames.push([200, () => feel(one, { flip: way < 0, eyes: "u" }, 0)], [500, () => feel(one, { flip: way > 0, eyes: "n" }, 0)]);
        for (let step = steps - 1; step >= 0; step--) { stride(step, -way); frames.push([0, () => shift(one, way * step * 2)]); }
        return frames;
      };
      const pace = (one: Member): boolean => { const frames = paces(one); if (frames) perform(one, frames); return !!frames; };
      let pastime = 0;
      window.setInterval(() => {
        if (asleep || document.hidden || talking || playing) return;
        const free = members.filter((one) => idle(one) && !one.busy && !one.up && !one.floating && !(one.state === "home" && (hiders.has(one) || one === codex)));
        if (!free.length) return;
        const one = free[pastime % free.length], turn = pastime++ % 3;
        const act = turn === 0 ? "sing" : turn === 1 ? "fight" : pace(one) ? "pace" : "sing";
        if (act === "sing") sing(one); else if (act === "fight") fight(one);
        // somebody nearby has an opinion about it
        const watcher = members.filter((other) => other !== one && idle(other) && !other.busy && inSight(other))[0];
        if (watcher && pastime % 2) window.setTimeout(() => speak(watcher, any1(audience[act]), act === "sing" ? "laugh" : "ask", 0, one), 1300);
      }, 4600);

      // ── conversation: now and then two of them have a word, or one tells the reader about the part of the page on screen
      const deck: TalkLine[][] = [];
      let chats = 0;
      const section = (): string => {
        if (lost) return "/404";                                // whatever the address was
        let found = "";
        for (const part of document.querySelectorAll<HTMLElement>("main [id]")) { const box = part.getBoundingClientRect(); if (box.top < window.innerHeight * 0.6 && box.bottom > window.innerHeight * 0.3 && places[part.id]) found = part.id; }
        return found || (places[location.pathname.replace(/\/$/, "")] ? location.pathname.replace(/\/$/, "") : "");
      };
      window.setInterval(() => {
        if (talking || playing || asleep || document.hidden || chase.left > 0) return;
        const cast = ranked(members.filter((one) => idle(one) && !one.busy && inSight(one)), (one) => persona[one.color].chat);   // the talkative ones speak first
        if (!cast.length) return;
        const here = section(), turn = chats++;
        if (turn % 3 === 1 && here) { const [words, mood] = places[here][Math.floor(turn / 3) % places[here].length]; speak(cast[0], words, mood); return; }
        if (cast.length < 2) return;
        if (!deck.length) deck.push(...[...scenes].sort(() => Math.random() - 0.5));
        converse(cast, deck.pop()!);
      }, 9000);
      // soon after the page opens, each says who it is; the reader's favourite of earlier visits goes first and knows them
      window.setTimeout(() => {
        if (talking || asleep) return;
        const seen = members.filter(inSight).sort((p, q) => Number(q === pet) - Number(p === pet));
        converse(seen, seen.map((one, index): TalkLine => (one === pet ? [index, any1(plays.pet.hello), "hi"] : [index, ...introductions[one.color]])));
        if (pet && seen[0] === pet) { leave(pet, "heart"); hop(pet, 22); }
      }, 3800);

      // ── playing together: what two or more of them do with each other
      // Who can take part: standing somewhere in sight with nothing else to do. The walker counts while it walks (it stops
      // for the occasion); the two behind the buttons do not, except in the games made for them.
      const still = (one: Member) => idle(one) || (one === codex && codex.walking && codex.state === "home");
      const free = (one: Member) => still(one) && !one.busy && !one.up && !one.floating && inSight(one) && !(one.state === "home" && hiders.has(one));
      const perched = (one: Member) => free(one) && one.state === "away" && !!one.perch;
      const apart = (p: Member, q: Member) => Math.hypot(feet(p).x - feet(q).x, feet(p).y - feet(q).y);
      const nearest = (one: Member, among: Member[]): Member | undefined => among.filter((other) => other !== one).sort((p, q) => apart(one, p) - apart(one, q))[0];
      function mixed<T>(list: T[]): T[] { return [...list].sort(() => Math.random() - 0.5); }
      // the walker stops where it is to take part in something; its walk starts again by itself
      const halt = (one: Member) => {
        if (one !== codex || !codex.walking) return;
        stroll?.pause(); window.clearInterval(stride); codex.walking = false; codex.pose = { ...codex.pose, legs: "stand" }; draw(codex);
        window.setTimeout(walk, 3000);
      };
      // an act for several: while it lasts nobody starts a pastime, a conversation or another game
      const together = (cast: Member[], script: (live: () => boolean) => Frame[], after?: () => void) => {
        playing = true; cast.forEach(halt);
        act(cast, script, () => { playing = false; after?.(); });
      };

      type Place = { spot: Spot; perch: Perch | null };
      // A place on the host's own edge, `gap` sprite pixels to one side of it, if the guest can stand there.
      const beside = (host: Member, side: number, gap: number, guest: Member): Place | null => {
        const edge = host.perch && edgeOf(host.perch);
        if (!edge || host.state !== "away" || host.floating) return null;
        const x = feet(host).x - window.scrollX + side * gap * pixel, y = edge.top + 1 + window.scrollY;
        if (x < edge.left + 5 * pixel || x > edge.right - 5 * pixel || x - wide() / 2 < 8 || x + wide() / 2 > window.innerWidth - 8 || !clear(x, edge.top)) return null;
        if (members.some((other) => other !== host && other !== guest && other.state !== "gone" && Math.hypot(feet(other).x - window.scrollX - x, feet(other).y - y) < 11 * pixel)) return null;
        return { spot: { x: x + window.scrollX, y, rest: 0 }, perch: { element: host.perch!.element, at: (x - edge.left) / edge.width, line: host.perch!.line } };
      };
      // One goes over to another, which waits for it. `then` runs once it is there, if the host has waited.
      const meet = (guest: Member, host: Member, spot: Spot, perch: Perch | null, then: () => void) => {
        const id = ++turns; let over = false;
        acting.set(host, id); host.busy = true; playing = true;
        feel(host, { ...toward(host, guest), eyes: "r" }, 1400);
        const release = () => { if (over) return false; over = true; playing = false; if (acting.get(host) !== id) return false; acting.delete(host); host.busy = false; return true; };
        voyage(guest, spot, perch, () => { if (release()) then(); else { feel(guest, { eyes: "happy", mouth: "smile", arms: "wave" }, 1100); play("hi", guest); } });
        window.setTimeout(() => { if (release()) { host.mood = null; draw(host); } }, 10000);
      };
      // Whether the edge a sprite stands on has open water under it, to both sides: a fall from there is seen. A heading
      // inside a card has none, and nobody is knocked off one.
      const wet = (one: Member) => {
        const edge = one.perch && edgeOf(one.perch);
        return !!edge && [-1, 0, 1].every((side) => shows({ x: feet(one).x + side * 15 * pixel, y: edge.top + 1 + window.scrollY + 24 }));
      };
      // Two on one edge, `gap` sprite pixels apart. If they are not neighbours yet, one swims over to the other first.
      const paired = (gap: number, then: (guest: Member, host: Member) => void, fits: (host: Member) => boolean = () => true): boolean => {
        for (const guest of ranked(members.filter(perched), bold)) {            // the bolder one is the one that goes over
          const host = nearest(guest, members.filter(perched).filter(wet).filter(fits));   // every game for two ends with somebody in the water
          if (!host) continue;
          const here = feet(host), there = feet(guest);
          if (Math.abs(there.y - here.y) < 3 && Math.abs(Math.abs(there.x - here.x) - gap * pixel) < 4 * pixel) { then(guest, host); return true; }
          for (const side of there.x < here.x ? [-1, 1] : [1, -1]) {
            const place = beside(host, side, gap, guest);
            if (place) { meet(guest, host, place.spot, place.perch, () => then(guest, host)); return true; }
          }
        }
        return false;
      };

      // what a sprite has shifted by becomes its place
      const plant = (one: Member) => {
        const here = feet(one), edge = one.perch && edgeOf(one.perch);
        shift(one, 0); stand(one, here.x, here.y);
        if (edge) one.perch = { ...one.perch!, at: (here.x - window.scrollX - edge.left) / edge.width };
      };
      // through the air to a point, in an arc; nothing happens at the end if the act it belongs to is over by then
      const fling = (one: Member, to: { x: number; y: number }, height: number, time: number, live: () => boolean, then: () => void) => {
        const from = feet(one), state = { p: 0 };
        animate(state, { p: 1, duration: time, ease: "linear",
          onUpdate: () => { if (live()) stand(one, from.x + (to.x - from.x) * state.p, from.y + (to.y - from.y) * state.p - Math.sin(state.p * Math.PI) * height); },
          onComplete: () => { if (live()) then(); } });
      };
      // Who is in the water after a fall, and the place each of them fell from.
      const dunked = new Map<Member, Place>();
      // Knocked off its edge: through the air and into the water `far` sprite pixels to one side, where it stays until
      // `ashore` brings it back to where it stood (or to `back`).
      const dunk = (one: Member, side: number, live: () => boolean, far = 15, back?: Place) => {
        plant(one);
        const here = feet(one), home = back ?? { spot: { x: here.x, y: here.y, rest: 0 }, perch: one.perch }, pool = { x: home.spot.x + side * far * pixel, y: home.spot.y + 24 };
        dunked.set(one, home);
        feel(one, { flip: side < 0, eyes: "wide", mouth: "o", arms: "up", legs: "tuck" }, 0); play("oh", one);
        animate(one.element, { rotate: side * 50, duration: 420, ease: "outQuad" });
        fling(one, pool, 34, 460, live, () => {
          animate(one.element, { rotate: 0, duration: 0 });
          one.post.classList.add("swims"); splash(pool.x, pool.y - line(), 1.1, one);
          feel(one, { flip: side < 0, eyes: "shut", mouth: "o", arms: "swimA", legs: "none" }, 0);
        });
      };
      const ashore = (one: Member, then?: () => void) => {
        const home = dunked.get(one);
        dunked.delete(one);
        if (!home || one.state !== "away") return;
        one.floating = true;                                    // it is in the water already: the way back starts with a swim, not a leap
        voyage(one, home.spot, home.perch, then);
      };
      // water thrown by a swimmer at somebody standing above it
      const douse = (from: Member, at: Member) => {
        const a = feet(from), b = feet(at), top = a.y - line(), time = 0.5;
        crewSoundAt("splash", from);
        for (let drop = 0; drop < 14; drop++) fleck(a.x + any(6), top, (b.x - a.x) / time + any(40), (b.y - 5 * pixel - top) / time - 0.5 * gravity * time + any(40), 2, undefined, b.y - 3 * pixel + any(8));
      };

      // Two spar face to face, blow for blow, until one is kicked into the water; it swims round and climbs back, sulking.
      const duel = (): boolean => paired(15, (a, b) => {
        const [winner, loser] = Math.random() < 0.5 ? [a, b] : [b, a];
        const way = (one: Member, other: Member) => (feet(other).x < feet(one).x ? -1 : 1);
        const guard = (one: Member, other: Member, more: SpritePose = {}) => feel(one, { ...toward(one, other), legs: "stance", arms: "guard", eyes: "r", ...more }, 0);
        const blow = (one: Member, other: Member) => { guard(other, one, { eyes: "shut" }); guard(one, other, { arms: "punch", mouth: "open" }); shift(one, way(one, other)); play("punch", one); };
        const back = () => { shift(a, 0); shift(b, 0); guard(a, b); guard(b, a); };
        together([a, b], (live) => [
          [0, () => { back(); speak(a, any1(plays.duel.start), "yay"); }],
          [800, () => blow(a, b)], [180, back], [240, () => blow(b, a)], [180, back], [220, () => blow(a, b)], [180, back], [220, () => blow(b, a)], [180, back],
          [320, () => { guard(winner, loser, { legs: "kick", mouth: "open", eyes: "wide" }); shift(winner, 2 * way(winner, loser)); play("kick", winner); dunk(loser, way(winner, loser), live); }],
          [580, () => { shift(winner, 0); feel(winner, { eyes: "happy", mouth: "smile", arms: "up", blush: true }, 0); leave(winner, "spark"); speak(winner, own(winner, "won", plays.duel.won), "yay"); }],
          [1500, () => {}],
        ], () => ashore(loser, () => { speak(loser, own(loser, "lost", plays.duel.lost), "hmm"); feel(loser, { ...toward(loser, winner), eyes: "sleepy" }, 2400); }));
      });

      // One swims under another and throws water at it, twice. The second time the wet one dives in after it; the
      // swimmer gets away to where it came from, and the other climbs back.
      const soak = (): boolean => {
        const soaker = ranked(members.filter((one) => perched(one) || (one.floating && one.state === "away" && !one.busy && inSight(one))), bold)[0];
        if (!soaker) return false;
        // under whom, and on which side: the nearest one beside which the swimmer is on screen and in plain sight
        // (measured from the edge it stands on, which is where the water is, not from its feet)
        const under = (one: Member, side: number) => { const edge = one.perch && edgeOf(one.perch); return { x: feet(one).x + side * 11 * pixel, y: (edge ? edge.top + 1 + window.scrollY : feet(one).y) + 24 }; };
        const fits = (one: Member, side: number) => { const at = under(one, side), x = at.x - window.scrollX; return x > 30 && x < window.innerWidth - 30 && shows(at); };
        const sides = (one: Member) => (feet(soaker).x < feet(one).x ? [-1, 1] : [1, -1]);
        const victim = members.filter((one) => one !== soaker && perched(one)).sort((p, q) => apart(soaker, p) - apart(soaker, q)).find((one) => sides(one).some((side) => fits(one, side)));
        if (!victim) return false;
        const dry: Place = { spot: { ...feet(victim), rest: 0 }, perch: victim.perch }, shore: Place | null = soaker.floating ? null : { spot: { ...feet(soaker), rest: 0 }, perch: soaker.perch };
        const side = sides(victim).find((way) => fits(victim, way))!;
        const pool: Spot = { ...under(victim, side), rest: 0, floats: true };
        const hurl = () => { feel(soaker, { ...toward(soaker, victim), legs: "none", arms: "up", eyes: "happy", mouth: "open" }, 0); douse(soaker, victim); };
        const wet = () => { animate(victim.element, { rotate: [0, -9, 8, -6, 4, 0], duration: 520, ease: "outQuad" }); feel(victim, { eyes: "shut", mouth: "o" }, 0); play("shake", victim); };
        meet(soaker, victim, pool, null, () => together([soaker, victim], () => [
          [300, hurl], [420, wet],
          [650, () => { feel(victim, { ...toward(victim, soaker), eyes: "wide", mouth: "o" }, 0); speak(victim, any1(plays.splash.hit), "oh"); feel(soaker, { ...toward(soaker, victim), legs: "none", arms: "swimA", eyes: "happy", mouth: "smile" }, 0); }],
          [1200, () => speak(soaker, own(soaker, "tease", plays.splash.tease), "laugh")],
          [1100, hurl], [420, wet],
          [650, () => { feel(victim, { ...toward(victim, soaker), eyes: "sleepy", arms: "up", legs: "stance" }, 0); speak(victim, any1(plays.splash.enough), "oh"); }],
          [1000, () => {}],
        ], () => {
          if (soaker.state !== "away" || !soaker.floating || victim.state !== "away") return;
          const lair: Spot = { ...feet(soaker), rest: 0, floats: true };
          const off = (place: { x: number; y: number }) => Math.hypot(place.x - lair.x, place.y - lair.y);
          const far = shore ? null : pools().sort((p, q) => off(q) - off(p))[0];
          if (shore) voyage(soaker, shore.spot, shore.perch, () => { speak(soaker, any1(race.ahead), "laugh"); feel(soaker, { eyes: "happy", mouth: "smile", arms: "wave" }, 1100); });
          else if (far) voyage(soaker, { ...far, rest: 0, floats: true }, null);
          voyage(victim, lair, null, () => voyage(victim, dry.spot, dry.perch, () => { speak(victim, own(victim, "wet", plays.splash.late), "hmm"); feel(victim, { eyes: "sleepy" }, 1800); }), 500);
        }));
        return true;
      };

      // One starts a song, the next comes in two beats later in its own voice, then a third; whoever is left has had enough.
      const chorus = (): boolean => {
        const voices = members.filter(free);
        if (voices.length < 2) return false;
        const choir = mixed(voices).slice(0, 3).sort((p, q) => feet(p).x - feet(q).x), critic = members.find((one) => !choir.includes(one) && one.state !== "swim" && inSight(one));
        together(choir, () => [
          ...weave(choir.map(song), 600),
          [300, () => choir.forEach((one) => feel(one, { eyes: "happy", mouth: "smile", arms: "up", blush: true }, 0))], [800, () => {}],
        ], () => { if (critic && !critic.busy) speak(critic, any1(plays.chorus), "hmm"); });
        return true;
      };

      // All four in sight: arms up and a hop, one after another from left to right, and back again.
      const wave = (): boolean => {
        const row = members.filter((one) => still(one) && !one.busy && !one.up && inSight(one)).sort((p, q) => feet(p).x - feet(q).x);
        if (row.length < members.length) return false;
        const lift = (one: Member) => {
          feel(one, { eyes: "happy", mouth: "open", arms: "up" }, 460);
          if (one.state === "home" && hiders.has(one)) { rise(one, true); window.setTimeout(() => rise(one, false), 460); }   // from behind its button
          else if (one.floating) play("hop", one);                                                                              // in the water: arms only
          else bounce(one, 16);
        };
        const pass = (line: Member[]): Frame[] => line.map((one, index) => [index ? 150 : 0, () => lift(one)]);
        together(row, () => [
          [0, () => speak(row[0], any1(plays.wave.start), "yay")], [900, () => {}], ...pass(row), [750, () => {}], ...pass([...row].reverse()),
          [900, () => speak(row[row.length - 1], any1(plays.wave.done), "yay")], [900, () => {}],
        ]);
        return true;
      };

      // The two behind the buttons: one comes up as the other ducks, faster and faster, until both are up at once.
      const peekaboo = (): boolean => {
        const [a, b] = Math.random() < 0.5 ? [aqua, claude] : [claude, aqua];
        if (![a, b].every((one) => one.state === "home" && hiders.has(one) && !one.up && !one.busy && inSight(one) && !hiders.get(one)!.matches(":hover, :focus-visible"))) return false;
        const up = (one: Member, other: Member, more: SpritePose = {}) => { rise(one, true); feel(one, { eyes: feet(other).x < feet(one).x ? "l" : "r", ...more }, 0); };
        const down = (one: Member) => { one.mood = null; draw(one); rise(one, false); };
        together([a, b], () => [
          [0, () => { up(a, b); speak(a, any1(plays.peekaboo.start), "hi"); }], [900, () => down(a)],
          [350, () => up(b, a)], [800, () => down(b)], [300, () => up(a, b)], [650, () => down(a)], [250, () => up(b, a)], [550, () => down(b)],
          [450, () => { up(a, b, { eyes: "wide", mouth: "o" }); up(b, a, { eyes: "wide", mouth: "o" }); speak(a, any1(plays.peekaboo.both), "oh"); }],
          [700, () => speak(b, any1(plays.peekaboo.after), "oh")],
          [1400, () => { down(a); down(b); }], [300, () => {}],
        ]);
        return true;
      };

      // One practises its kung fu or takes a walk and its neighbour does the same a moment behind, until it is caught.
      const copycat = (): boolean => {
        const mimic = ranked(members.filter(free), bold)[0], lead = mimic && nearest(mimic, members.filter(free));
        if (!lead) return false;
        const walks = [paces(lead), paces(mimic)], moves = walks[0] && walks[1] && Math.random() < 0.5 ? [walks[0], walks[1]] : [kata(lead), kata(mimic)];
        together([lead, mimic], () => [
          ...weave(moves, 340),
          [350, () => { feel(lead, { ...toward(lead, mimic), eyes: "sleepy" }, 0); speak(lead, any1(plays.copycat.stop), "hmm"); }],
          [800, () => { feel(mimic, { flip: !toward(mimic, lead).flip, eyes: "u", mouth: "o" }, 0); leave(mimic, "note"); play("note", mimic, 4); }],
          [1100, () => speak(mimic, any1(plays.copycat.who), "ask")],
          [1200, () => {}],
        ]);
        return true;
      };

      // A dare, and two of them swim for two free edges; `land` knows who got there first.
      const regatta = (): boolean => {
        const racers = ranked(members.filter(perched), bold).slice(0, 2);
        if (racers.length < 2) return false;
        const [first, other] = racers, from = { x: (feet(first).x + feet(other).x) / 2, y: (feet(first).y + feet(other).y) / 2 };
        const off = (p: { x: number; y: number }, q: { x: number; y: number }) => Math.hypot(p.x - q.x, p.y - q.y);
        const open = perches().filter((place) => members.every((one) => off(feet(one), place) > wide() * 2.4 && (!one.goal || off(one.goal, place) > wide() * 2.4))).sort((p, q) => off(q, from) - off(p, from));
        const finish = open[0], second = finish && open.filter((place) => off(place, finish) > wide() * 1.3).sort((p, q) => off(p, finish) - off(q, finish))[0];
        if (!second) return false;
        together(racers, () => [
          [0, () => { feel(first, { ...toward(first, other), arms: "wave", eyes: "r" }, 0); speak(first, any1(plays.race.dare), "yay"); }],
          [1500, () => { feel(other, { ...toward(other, first), eyes: "r" }, 0); speak(other, any1(plays.race.accept), "chat"); }],
          [1400, () => speak(first, any1(plays.race.go), "yay")], [500, () => {}],
        ], () => {
          if (!racers.every((one) => one.state === "away")) return;
          contest(racers);
          travel(first, { x: finish.x, y: finish.y, rest: 0 }, false, finish.perch); travel(other, { x: second.x, y: second.y, rest: 0 }, false, second.perch);
        });
        return true;
      };

      // One creeps up behind another that is singing and shoves it into the water.
      const prank = (): boolean => {
        const joker = ranked(members.filter(perched), bold)[0], victim = joker && nearest(joker, members.filter(perched).filter(wet));
        if (!victim) return false;
        for (const side of feet(joker).x < feet(victim).x ? [-1, 1] : [1, -1]) {
          const place = beside(victim, side, 22, joker), way = -side;   // the joker lands a few steps off, behind the singer's back
          if (!place || !beside(victim, side, 13, joker)) continue;
          const sneaky = (more: SpritePose = {}): SpritePose => ({ flip: way < 0, arms: "creep", eyes: "r", ...more });
          const sneak = (step: number): Frame => [300, () => { feel(joker, sneaky({ legs: step % 2 ? "walkA" : "walkB" }), 0); shift(joker, way * step * 2); play("step", joker); }];
          meet(joker, victim, place.spot, place.perch, () => together([joker, victim], (live) => [
            [0, () => { feel(joker, sneaky(), 0); speak(joker, any1(plays.prank.hush), "hmm"); }],
            [700, () => {}], sneak(1), sneak(2), sneak(3), sneak(4),
            [400, () => feel(joker, sneaky({ eyes: "happy", mouth: "smile" }), 0)],
            [450, () => { feel(joker, { flip: way < 0, arms: "push", legs: "stance", eyes: "wide", mouth: "open" }, 0); shift(joker, way * 10); play("punch", joker); dunk(victim, way, live); }],
            [580, () => { plant(joker); feel(joker, { flip: way < 0, eyes: "happy", mouth: "open", arms: "up", blush: true }, 0); speak(joker, own(joker, "prank", plays.prank.done), "laugh"); }],
            [1500, () => {}],
          ], () => ashore(victim, () => { speak(victim, own(victim, "wet", plays.prank.wet), "hmm"); feel(victim, { ...toward(victim, joker), eyes: "sleepy" }, 2400); })));
          // the one about to get wet sings with its back turned, from the moment the joker sets off until the shove
          let beat = 0;
          const hum = window.setInterval(() => {
            if (!victim.busy || victim.state !== "away" || dunked.has(victim)) { window.clearInterval(hum); return; }
            feel(victim, { flip: side > 0, eyes: "shut", mouth: beat % 2 ? "o" : "open", arms: beat % 2 ? "wave" : "up", blush: true }, 0);
            play("note", victim, beat); if (beat++ % 3 === 0) leave(victim, "note");
          }, 300);
          return true;
        }
        return false;
      };

      // A sign thrown back and forth over the page; the last throw is sometimes dropped into the water.
      const toss = (): boolean => {
        const thrower = ranked(members.filter(free), bold)[0], catcher = thrower && nearest(thrower, members.filter(free));
        if (!catcher || apart(thrower, catcher) > 900 || apart(thrower, catcher) < wide() * 1.5) return false;
        const sign = any1<SpriteSign>(["heart", "star", "spark"]), miss = Math.random() < 0.5, far = apart(thrower, catcher);
        const time = Math.min(1100, Math.max(520, far * 1.5)), high = Math.min(150, Math.max(36, far * 0.3));
        const head = (one: Member) => ({ x: feet(one).x, y: feet(one).y - 17 * one.size });
        const fly = (from: Member, to: Member, live: () => boolean, lost: boolean) => {
          const a = head(from), b = lost ? { x: feet(to).x + (a.x < feet(to).x ? 1 : -1) * 10 * pixel, y: feet(to).y + 24 - line() } : head(to);
          const mark = document.createElement("span"), state = { p: 0 };
          mark.className = "crew-toss"; mark.innerHTML = signSvg(sign, Math.max(2, pixel - 1)); mark.style.left = `${a.x}px`; mark.style.top = `${a.y}px`; crew.append(mark);
          feel(from, { ...toward(from, to), arms: "punch", mouth: "open", eyes: "r" }, 0); feel(to, { ...toward(to, from), arms: "up", eyes: "u" }, 0); play("hop", from);
          animate(state, { p: 1, duration: time, ease: "linear",
            onUpdate: () => { mark.style.left = `${a.x + (b.x - a.x) * state.p}px`; mark.style.top = `${a.y + (b.y - a.y) * state.p - Math.sin(state.p * Math.PI) * high}px`; },
            onComplete: () => {
              mark.remove();
              if (!live()) return;
              if (lost) { splash(b.x, b.y, 0.5, to); feel(to, { ...toward(to, from), eyes: "d", mouth: "o", arms: "up" }, 0); }
              else { play("pop", to); feel(to, { ...toward(to, from), eyes: "happy", mouth: "smile", arms: "up" }, 0); feel(from, { ...toward(from, to), eyes: "r" }, 0); }
            } });
        };
        together([thrower, catcher], (live) => [
          [0, () => { speak(thrower, any1(plays.toss.throw), "yay"); fly(thrower, catcher, live, false); }],
          [time + 450, () => fly(catcher, thrower, live, false)],
          [time + 450, () => fly(thrower, catcher, live, miss)],
          [time + 200, () => { if (miss) speak(catcher, any1(plays.toss.missed), "oh"); else { leave(catcher, sign); speak(catcher, any1(plays.toss.caught), "yay"); } }],
          [1100, () => { if (miss) { feel(thrower, { ...toward(thrower, catcher), eyes: "sleepy" }, 0); speak(thrower, any1(plays.toss.tease), "laugh"); } }],
          [1100, () => {}],
        ]);
        return true;
      };

      // One climbs on its neighbour's head for the view; the one below sways, and both end up in the water.
      const tower = (): boolean => {
        const top = 10 * pixel;                                 // how high above the edge the one on top stands
        const room = (host: Member) => { const edge = host.perch && edgeOf(host.perch); return !!edge && edge.top - top - tall() > 90 && clear(feet(host).x - window.scrollX, edge.top - top); };
        return paired(13, (climber, base) => {
          const seat: Place = { spot: { ...feet(climber), rest: 0 }, perch: climber.perch }, lean = feet(climber).x < feet(base).x ? 1 : -1;   // they fall away from where the climber came from
          const sway = [0, 4, -4, 7, -7, 10, -10, 12].map((turn) => turn * lean);
          together([climber, base], (live) => [
            [0, () => { feel(climber, { ...toward(climber, base), eyes: "u" }, 0); speak(climber, any1(plays.tower.want), "ask"); }],
            [1100, () => {
              feel(climber, { ...toward(climber, base), legs: "tuck", arms: "up", eyes: "u" }, 0); play("leap", climber);
              fling(climber, { x: feet(base).x, y: feet(base).y - top }, 24, 380, live, () => {
                play("land", climber); feel(climber, { flip: lean < 0, arms: "wave", eyes: "r" }, 0); feel(base, { eyes: "wide", mouth: "o" }, 0);
                animate(base.element, { scaleY: [0.8, 1.04, 1], scaleX: [1.14, 0.97, 1], duration: 420, ease: "outQuad" });
              });
            }],
            [1000, () => speak(climber, any1(plays.tower.view), "yay")],
            [1400, () => {
              speak(base, any1(plays.tower.heavy), "oh"); feel(climber, { eyes: "wide", mouth: "o", arms: "up" }, 0);
              animate(base.element, { rotate: sway, duration: 1500, ease: "linear" });
              animate(climber.element, { x: sway.map((turn) => turn * 0.9), rotate: sway, duration: 1500, ease: "linear" });
            }],
            [1500, () => { animate(climber.element, { x: 0, duration: 0 }); dunk(base, lean, live, 12); dunk(climber, lean, live, 38, seat); }],
            [1200, () => {}],
          ], () => {
            // cut short with one still on the other's head: it goes back to where it stood
            animate(climber.element, { x: 0, duration: 0 });
            if (!dunked.has(climber) && climber.state === "away") { animate(climber.element, { rotate: 0, duration: 0 }); stand(climber, seat.spot.x, seat.spot.y); }
            if (!dunked.has(base) && base.state === "away") animate(base.element, { rotate: 0, duration: 0 });
            ashore(base, () => { speak(base, own(base, "wet", [plays.tower.wet[0]]), "hmm"); feel(base, { ...toward(base, climber), eyes: "sleepy" }, 2400); });
            ashore(climber, () => window.setTimeout(() => speak(climber, any1(plays.tower.wet.slice(1)), "laugh"), 1200));
          });
        }, room);
      };

      // One sits on its edge with a rod. Another swims up to the line, bites, and is pulled out onto the edge beside it.
      const rodSvg = () => {
        let rects = "";
