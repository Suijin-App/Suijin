      };
      const tug = (): boolean => paired(30, (a, b) => {
        const [left, right] = feet(a).x < feet(b).x ? [a, b] : [b, a], pull = (one: Member) => persona[one.color].pull;
        const winner = Math.random() < pull(a) / (pull(a) + pull(b)) ? a : b, loser = winner === a ? b : a, way = winner === right ? 1 : -1;   // the way the rope goes in the end
