---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import AppMock from "../components/AppMock.astro";
import { site, faq, agents, downloadUrl } from "../site";
import splitPanes from "../../../docs/screenshots/split-panes.png";
import orchestration from "../../../docs/screenshots/orchestration.png";
import changes from "../../../docs/screenshots/changes.png";
import accounts from "../../../docs/screenshots/accounts.png";
import discord from "../assets/discord.svg?raw";

const title = "Suijin: Claude Code, Codex and more, side by side on your Mac";
const released = site.releasedVersion !== null;

const application = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: site.name,
  description: site.description,
  url: site.url,
  image: new URL("/og.png", site.url).href,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS 15 or later",
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  codeRepository: site.repository,
  ...(released ? { softwareVersion: site.releasedVersion, downloadUrl } : {}),
  author: { "@type": "Person", name: site.developer.name, url: site.developer.url },
  publisher: { "@type": "Organization", name: site.publisher },
  featureList: [
    "Runs Claude Code, Codex and any other command-line AI coding agent at the same time",
    "One git worktree per agent",
    "Split tabs with up to ten sessions",
    "Native diff viewer, commit, push and pull requests",
    "Agent orchestration: one agent starts and coordinates others",
    "Several managed accounts per agent with automatic switching",
    "Sessions keep running after the app quits",
  ],
};
const questions = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
const shot = { widths: [520, 840, 1200], sizes: "(max-width: 980px) 92vw, 560px", format: "webp" as const, quality: 84 };
const download = downloadUrl ?? site.repository;
// The agents' logos, as SVG text, keyed by path.
const logos = import.meta.glob<string>("../assets/agents/*.svg", { query: "?raw", import: "default", eager: true });
---

<Base title={title} description={site.description} path="/" structuredData={[application, questions]}>
  <div class="hero">
    <svg class="ripples" viewBox="0 0 1600 1600" aria-hidden="true">
      <circle cx="800" cy="800" r="780"></circle><circle cx="800" cy="800" r="780"></circle>
      <circle cx="800" cy="800" r="780"></circle><circle cx="800" cy="800" r="780"></circle>
    </svg>
    <div class="wrap">
      <a class="pill" href="/releases"><i class="dot"></i>{released ? `Version ${site.releasedVersion} is out` : "First release on its way"} · see the release notes</a>
      <h1>
        Many agents,<br />one{" "}<em>calm<svg viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true"><path d="M2 12 C 30 2, 50 20, 78 11 S 128 2, 152 11 S 186 18, 198 8"></path></svg></em>{" "}window.
      </h1>
      <p class="lead">
        Suijin is a native macOS app that runs Claude Code, Codex and any other AI coding agent side by side, each in a
        git worktree of its own.
      </p>
      <div class="actions">
        <a class="button primary" href={download}>
          {released ? (
            <svg class="apple" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.040-2.040.027-3.910 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.090 1.013 1.454 2.208 3.090 3.792 3.039 1.520-.065 2.090-.987 3.935-.987 1.831 0 2.350.987 3.960.948 1.637-.026 2.676-1.480 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.220-4.857-.026-3.040 2.480-4.494 2.597-4.559-1.429-2.090-3.623-2.324-4.390-2.376-2-.156-3.675 1.090-4.610 1.090zM15.530 3.830c.843-1.012 1.400-2.427 1.245-3.830-1.207.052-2.662.805-3.532 1.818-.780.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/></svg>
          ) : (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14"/></svg>
          )}
          {released ? "Download for macOS" : "Get Suijin on GitHub"}
        </a>
        <a class="button secondary" href="#features">See what it does</a>
      </div>
      <p class="meta">{site.minimumSystem} or later · open source, {site.license} · your code stays on your Mac</p>

      <AppMock />
    </div>
  </div>

  <div class="agents" id="agents">
    <div class="wrap center">
      <p class="eyebrow">Bring your own agent</p>
      <h2 data-reveal>Every agent that runs in a terminal runs here</h2>
      <p class="sub" data-reveal>
        Claude Code and Codex are built in, with status, accounts, permission modes and orchestration. Any other
        command-line agent runs in a shell pane next to them, in its own worktree.
      </p>
      <div class="chips">
        {agents.map((agent) => (
          <span class={`chip ${agent.builtIn ? "built" : ""}`} data-reveal>
            {agent.icon
              ? <span class="logo" set:html={logos[`../assets/agents/${agent.icon}.svg`]} />
              : <span class="logo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 8 4 4-4 4M12 16h7"/></svg></span>}
            {agent.name}
            {agent.builtIn && <small>built in</small>}
          </span>
        ))}
      </div>
    </div>
  </div>

  <section id="features">
    <div class="wrap">
      <p class="eyebrow">Features</p>
      <h2 data-reveal>From "start an agent" to "merge the pull request"</h2>
      <p class="sub" data-reveal>One window for the whole loop: run agents in parallel, watch them, review what they changed, and ship it.</p>

      <div class="bento">
        <article class="card wide" data-reveal>
          <div class="body">
            <h3>Split anything</h3>
            <p>A tab holds up to ten sessions as panes. Split right or down, drag a pane by its header to rearrange, zoom the one you are reading.</p>
            <div class="keys"><kbd>⌘T</kbd><kbd>⌘D</kbd><kbd>⇧⌘D</kbd><kbd>⇧⌘↩</kbd></div>
          </div>
          <div class="shot"><Image src={splitPanes} alt="A tab split into four panes: Claude Code, Codex and two shells working in the same worktree." {...shot} /></div>
        </article>
        <article class="card wide" data-reveal>
          <div class="body">
            <h3>Agents that run agents</h3>
            <p>Ask for "Suijin workers" and an agent starts others with the bundled <code>suijin</code> command, answers their questions and collects their results.</p>
          </div>
          <div class="shot"><Image src={orchestration} alt="A coordinator agent receiving the result of a worker, with both workers marked Done in the sidebar." {...shot} /></div>
        </article>

        <article class="card" data-reveal>
          <div class="body">
            <div class="glyph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="5" r="2.2"/><circle cx="6" cy="19" r="2.2"/><circle cx="18" cy="8" r="2.2"/><path d="M6 7.2v9.6M18 10.2c0 4-6 3-11 5"/></svg></div>
            <h3>One worktree each</h3>
            <p>Every agent gets its own folder on its own branch, so two of them can change the same project without overwriting each other.</p>
          </div>
        </article>
        <article class="card" data-reveal>
          <div class="body">
            <div class="glyph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/><circle cx="12" cy="12" r="3"/></svg></div>
            <h3>Sessions that outlive the app</h3>
            <p>Agents run in a background helper. Quit or update Suijin and they keep working; open it again and they are where you left them.</p>
          </div>
        </article>
        <article class="card" data-reveal>
          <div class="body">
            <div class="glyph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4.5 6v5.5c0 4.6 3.1 8 7.5 9.5 4.4-1.5 7.5-4.9 7.5-9.5V6L12 3Z"/><path d="m9 12 2.2 2.2L15.2 10"/></svg></div>
            <h3>Permission modes</h3>
            <p>Start each session in Ask, Auto-Accept Edits, Plan or Skip All Permissions. A session that skips checks carries a warning badge.</p>
          </div>
        </article>

        <article class="card wide" data-reveal>
          <div class="body">
            <h3>Review, commit, pull request</h3>
            <p>A native diff viewer with syntax highlighting. Leave a note on a line and send it back to the agent, then commit and open the pull request from the same tab.</p>
          </div>
          <div class="shot"><Image src={changes} alt="The Changes tab listing a changed Swift file next to a diff with added lines highlighted." {...shot} /></div>
        </article>
        <article class="card wide" data-reveal>
          <div class="body">
            <h3>Several accounts, switched for you</h3>
            <p>Add more than one Claude or Codex account. When one hits its usage limit, the session moves to the next account with room, conversation included.</p>
          </div>
          <div class="shot"><Image src={accounts} alt="Settings, Accounts: two Claude accounts, automatic switching on, and the order accounts are tried in." {...shot} /></div>
        </article>

        <article class="card" data-reveal>
          <div class="body">
            <div class="glyph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2.5"/><path d="m8 15 3-3.2 2.4 2.2L16 11l2 2.4"/><circle cx="8.6" cy="9" r="1.2"/></svg></div>
            <h3>See what they made</h3>
            <p>Markdown rendered, code highlighted, images you can zoom, video and audio with a player, all in a tab next to the agent.</p>
          </div>
        </article>
        <article class="card" data-reveal>
          <div class="body">
            <div class="glyph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9a6 6 0 1 1 12 0c0 6 2.5 7 2.5 7h-17S6 15 6 9Z"/><path d="M10 19.5a2.2 2.2 0 0 0 4 0"/></svg></div>
            <h3>Know when to look</h3>
            <p>A status on every session and a notification when an agent finishes or waits for you, so you can look away.</p>
          </div>
        </article>
        <article class="card" data-reveal>
          <div class="body">
            <div class="glyph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19V10M10 19V5M16 19v-6M22 19H2"/></svg></div>
            <h3>Usage in plain sight</h3>
            <p>Each plan's limits in the status bar, and tokens, estimated cost and activity per day in Settings.</p>
          </div>
        </article>
        <article class="card native" data-reveal>
          <div class="body">
            <h3>Native, so it stays light</h3>
            <p>
              Suijin is written in Swift with SwiftUI and AppKit. There is no web browser bundled inside it, so the
              window that holds your agents costs little next to the agents themselves.
            </p>
          </div>
          <dl class="facts">
            <div><dt>68 MB</dt><dd>of memory with the app open and no sessions</dd></div>
            <div><dt>20 MB</dt><dd>to download</dd></div>
            <div><dt>0</dt><dd>bundled browser engines</dd></div>
          </dl>
          <p class="note">Measured on Suijin 0.1.0 on an Apple silicon Mac. Every agent and shell you start uses memory of its own.</p>
        </article>
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <h2 data-reveal>Three steps to parallel work</h2>
      <div class="steps">
        <div class="step" data-reveal>
          <h3>Add a workspace</h3>
          <p>Point Suijin at a git repository, or at a plain folder if you do not need branches and diffs.</p>
        </div>
        <div class="step" data-reveal>
          <h3>Give each agent a worktree</h3>
          <p>Create a worktree on a new branch and start an agent in it. Repeat for as many agents as the job needs.</p>
        </div>
        <div class="step" data-reveal>
          <h3>Review and ship</h3>
          <p>Read each branch's diff, send notes back, then commit and open the pull request without switching apps.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="local">
    <div class="wrap grid">
      <div>
        <p class="eyebrow">Private by design</p>
        <h2 data-reveal>Your code stays on your Mac</h2>
        <p class="sub" data-reveal>Suijin is a native app, not a service. There is nothing to sign up for and no server of ours between you and your agents.</p>
        <a class="text-link" href="/privacy">Read the privacy page →</a>
      </div>
      <ul>
        {[
          ["No account, no telemetry", "Suijin sends no analytics and no crash reports."],
          ["Your logins are never touched", "Managed accounts live in Suijin's own folder; ~/.claude and ~/.codex stay as they are."],
          ["Online only for updates", "About once a day the app asks suijin.app for a newer version. That request carries the app's version and nothing about you."],
        ].map(([head, text]) => (
          <li data-reveal>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
            <div><strong>{head}</strong><span>{text}</span></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="faq">
    <div class="wrap faq-grid">
      <div class="faq-head">
        <p class="eyebrow">Questions</p>
        <h2>Frequently asked</h2>
        <p class="sub">Something missing? <a href={site.repository + "/issues"}>Ask on GitHub</a>.</p>
      </div>
      <div class="faq-list" data-faq>
        {faq.map((item, index) => (
          <div class="qa" data-reveal data-open={index === 0 ? "" : undefined}>
            <h3>
              <button type="button" aria-expanded={index === 0 ? "true" : "false"} aria-controls={`answer-${index}`}>
                <span class="num">{String(index + 1).padStart(2, "0")}</span>
                <span>{item.question}</span>
                <span class="plus" aria-hidden="true"></span>
              </button>
            </h3>
            <div class="answer" id={`answer-${index}`} role="region">
              <div><p>{item.answer}</p></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="community" id="community">
    <div class="wrap">
      <div>
        <p class="eyebrow">Community</p>
        <h2 data-reveal>Built in the open, with the people who use it</h2>
        <p class="sub" data-reveal>Ask a question, show what your agents shipped, or tell us what is missing. Suijin's roadmap is shaped there.</p>
      </div>
      <div class="links">
        <a class="link-card" href={site.discord} target="_blank" rel="noopener" data-reveal>
          <span class="logo big" set:html={discord} />
          <span><strong>Discord</strong><em>Chat with the team and other users</em></span>
          <span class="go" aria-hidden="true">→</span>
        </a>
        <a class="link-card" href={site.repository} target="_blank" rel="noopener" data-reveal>
          <span class="logo big"><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg></span>
          <span><strong>GitHub</strong><em>Source, issues and discussions</em></span>
          <span class="go" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="get" id="get">
    <svg class="ripples" viewBox="0 0 1600 1600" aria-hidden="true">
      <circle cx="800" cy="800" r="780"></circle><circle cx="800" cy="800" r="780"></circle>
      <circle cx="800" cy="800" r="780"></circle><circle cx="800" cy="800" r="780"></circle>
    </svg>
    <div class="wrap">
      <img class="icon" src="/icon-512.png" alt="" width="84" height="84" loading="lazy" />
      <h2>{released ? "Download Suijin" : "Suijin is almost here"}</h2>
      <p class="sub" style="margin-inline:auto">
        {released
          ? `Suijin ${site.releasedVersion} needs ${site.minimumSystem} or later. It is signed with a Developer ID, notarized by Apple, and updates itself.`
          : `The first public release is being prepared. Suijin needs ${site.minimumSystem} or later; until the download is up, the source and build instructions are on GitHub.`}
      </p>
      <div class="actions">
        <a class="button primary" href={download}>
          {released && (
            <svg class="apple" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.040-2.040.027-3.910 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.090 1.013 1.454 2.208 3.090 3.792 3.039 1.520-.065 2.090-.987 3.935-.987 1.831 0 2.350.987 3.960.948 1.637-.026 2.676-1.480 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.220-4.857-.026-3.040 2.480-4.494 2.597-4.559-1.429-2.090-3.623-2.324-4.390-2.376-2-.156-3.675 1.090-4.610 1.090zM15.530 3.830c.843-1.012 1.400-2.427 1.245-3.830-1.207.052-2.662.805-3.532 1.818-.780.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/></svg>
          )}
          {released ? "Download for macOS" : "Open the repository"}
        </a>
        <a class="button secondary" href="/releases">Release notes</a>
      </div>
    </div>
  </section>

  <script>
    // One answer open at a time; the open one slides, the plus turns into a minus.
    document.querySelectorAll<HTMLElement>("[data-faq] .qa").forEach((item, _, all) => {
      const button = item.querySelector("button");
      button?.addEventListener("click", () => {
        const open = item.hasAttribute("data-open");
        all.forEach((other) => {
          other.removeAttribute("data-open");
          other.querySelector("button")?.setAttribute("aria-expanded", "false");
        });
        if (!open) {
          item.setAttribute("data-open", "");
          button.setAttribute("aria-expanded", "true");
        }
      });
    });
  </script>
</Base>
