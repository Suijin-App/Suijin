      }, 9000);
      // soon after the page opens, each says who it is
      window.setTimeout(() => { if (!talking && !asleep) converse(members.filter(inSight), members.filter(inSight).map((one, index) => [index, ...introductions[one.color]] as TalkLine)); }, 3800);

      // ── habits
      // blinking, each at its own pace
      members.forEach((one, index) => {
        const blink = () => {
