# Sevinda: `claude` runs under the Claude account selected in Sevinda (zsh).
# Generated by Sevinda and rewritten when it changes.
#
# Every run re-reads $SEVINDA_DATA_ROOT/claude-profiles/selected-host (an absolute config directory), so switching accounts
# in Sevinda applies to the next `claude` without reopening the terminal. An empty or missing pointer keeps your
# default login. A CLAUDE_CONFIG_DIR you set yourself wins, and so does a claude function you defined yourself: this file then
# defines nothing. Running under a Sevinda account unsets API-key variables that would override its login.
#
# While it runs, the tab shows Claude with its status: the run is announced to Sevinda (see the shell integration's
# __sevinda_agent_begin), and Claude gets Sevinda's hooks through `--settings`.
if ! typeset -f claude >/dev/null 2>&1; then
  function __sevinda_claude_run {
    local __sevinda_pointer __sevinda_home=""
    local -a __sevinda_settings=()
    # Sevinda's hooks (`--settings`, merged with your own settings) report when Claude waits or finishes a turn.
    if [[ -n "${SEVINDA_CLAUDE_SETTINGS:-}" && -r "$SEVINDA_CLAUDE_SETTINGS" ]]; then
      __sevinda_settings=(--settings "$SEVINDA_CLAUDE_SETTINGS")
    fi
    if [[ -n "${CLAUDE_CONFIG_DIR:-}" || -z "${SEVINDA_DATA_ROOT:-}" ]]; then
      command claude ${__sevinda_settings[@]+"${__sevinda_settings[@]}"} "$@"
      return
    fi
    __sevinda_pointer="${SEVINDA_DATA_ROOT}/claude-profiles/selected-host"
    if [[ -r "$__sevinda_pointer" ]]; then
      __sevinda_home="$(cat -- "$__sevinda_pointer" 2>/dev/null)"
    fi
    if [[ -z "$__sevinda_home" ]]; then
      command claude ${__sevinda_settings[@]+"${__sevinda_settings[@]}"} "$@"
      return
    fi
    # Refuse rather than run under the wrong account.
    if [[ "$__sevinda_home" != /* ]]; then
      printf '%s\n' "sevinda: the selected Claude account is not an absolute path ($__sevinda_pointer); claude not started." >&2
      return 1
    fi
    # A private folder, like the one Sevinda creates for an account.
    [[ -d "$__sevinda_home" ]] || mkdir -p -m 700 -- "$__sevinda_home" 2>/dev/null
    (
      unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN AWS_BEARER_TOKEN_BEDROCK
      export CLAUDE_CONFIG_DIR="$__sevinda_home"
      command claude ${__sevinda_settings[@]+"${__sevinda_settings[@]}"} "$@"
    )
  }
  # Tells Sevinda that claude runs in this terminal, and when it is done. The prompt hook (__sevinda_agent_prompt)
  # reports the end too when Ctrl-C or a crash skipped the last line.
  function claude {
    local __sevinda_status
    __sevinda_agent_begin claude
    __sevinda_claude_run "$@"
    __sevinda_status=$?
    __sevinda_agent_end "$__sevinda_status"
    return "$__sevinda_status"
  }
fi
